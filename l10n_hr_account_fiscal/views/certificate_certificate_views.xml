<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="certificate_certificate_view_form_l10n_hr" model="ir.ui.view">
            <field name="name">certificate_certificate_view_form_l10n_hr</field>
            <field name="model">certificate.certificate</field>
            <field name="inherit_id" ref="certificate.certificate_certificate_view_form"/>
            <field name="arch" type="xml">
                <field name="company_id" position="after">
                    <field name="l10n_hr_type" string="FINA Type"/>
                    <field name="l10n_hr_subject_vat"/>
                </field>
            </field>
        </record>


        <record id="action_fiscal_certificate" model="ir.actions.act_window">
            <field name="name">Fiscal Certificates</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">certificate.certificate</field>
            <field name="domain">[('scope', '=', 'fina')]</field>
            <field name="context">{'default_scope': 'fina'}</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
                id="menu_action_fiscal_certificate"
                action="action_fiscal_certificate"
                parent="l10n_hr_account_base.menu_finance_config_croatia"
                sequence="100"
        />

    </data>
</odoo>