<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_view_l10n_hr_move_form" model="ir.ui.view">
        <field name="name">inherit_view_l10n_hr_move_form</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_l10n_hr_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='croatia']//group[@name='l10n_hr_base_fiscal']" position="after">
                <group>
                    <field name="country_code" invisible="1"/>
                    <field name="working_place_id"/>
                    <field name="journal_type" invisible="1"/>
                    <field name="use_fiscalization" invisible="1"/>
                </group>

                <group name="l10n_hr_fiscal" string="Fiscal Debug" groups="base.group_no_one">
                    <field name="sequence_number"/>
                    <field name="journal_id"/>
                </group>
            </xpath>

            <xpath expr="/form/header/button[last()]" position="after">
                <button name="do_fiscal" string="Fiscalize" type="object" class="oe_highlight"/>
            </xpath>
            <xpath expr="//page[@name='croatia']" position="after">
                <page string="Fiscalization">
                    <group colspan="8" col="8">
                        <group colspan="2">
                            <field name="number_par"/>
                            <field name="number_zki"/>
                            <field name="number_jir"/>
                        </group>
                        <group colspan="2">
                            <field name="fisc_user_id" invisible="1"/>
                            <field name="fisc_employee_id"/>
                            <field name="fisc_date"/>
                            <field name="fisc_state"/>
                        </group>
                        <group colspan="2">
                            <field name="fisc_qr_code" widget="image"/>
                        </group>
                    </group>
                    <newline/>
                    <notebook colspan="4">
                        <page string="Fiscalization sent">
                            <separator string="Fisc send data" colspan="4"/>
                            <field name="last_msg_snd" colspan="4" nolabel="1"/>
                        </page>
                        <page string="Fiscalization received">
                            <separator string="Fisc receive data" colspan="4"/>
                            <field name="last_msg_rcv" colspan="4" nolabel="1"/>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
