<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="l10n_hr_report_invoice_document" inherit_id="account.report_invoice_document">
        <!-- modifiy name to fiskal number for croatia-->
        <xpath expr="//t[@t-set='layout_document_title']/span[last()]" position="replace">
            <t t-if="o.country_code == 'HR'">
                <span t-if="o.name != '/'" t-field="o.l10n_hr_fiscal_number" />
            </t>
            <t t-else="">
                <span t-if="o.name != '/'" t-field="o.name" />
            </t>
        </xpath>

        <!-- NOTE: invoice_date and l10n_hr_invoice_time should be inside same day,  we don't need to show them twice -->
        <div name="invoice_date" position="inside">
            <div t-field="o.country_code == 'HR' and o.l10n_hr_invoice_time" t-options="{'time_only': True}"/>
        </div>

        <div name="delivery_date" position="after">
            <div class="col" t-if="o.country_code == 'HR' and o.name and o.name != o.l10n_hr_fiscal_number" name="l10n_hr_invoice_time">
                <strong>Internal Number</strong>
                <div t-field="o.name"/>
            </div>
            <div class="col" t-if="o.country_code == 'HR' and o.l10n_hr_account_payment_type_id" name="l10n_hr_payment_method">
                <strong>Payment Method</strong>
                <div t-field="o.l10n_hr_account_payment_type_id"/>
            </div>
            <div class="col" t-if="o.country_code == 'HR' and o.l10n_hr_fiscal_device_id.l10n_hr_invoice_place != '' or o.l10n_hr_fiscal_device_id.l10n_hr_business_premise_id.l10n_hr_invoice_place!= ''" name="l10n_place_of_issue">
                <strong>Place Of Issue</strong>
                <div t-esc="o.l10n_hr_fiscal_device_id.l10n_hr_invoice_place or o.l10n_hr_fiscal_device_id.l10n_hr_business_premise_id.l10n_hr_invoice_place"/>
            </div>
            <div class="col" t-if="o.country_code == 'HR' and o.invoice_user_id" name="invoice_user_id">
                <strong>Issued By</strong>
                <div t-field="o.invoice_user_id"/>
            </div>
        </div>

        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                Company ID: <span t-field="o.partner_id.company_registry"/>
            </div>
        </xpath>

        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                Company ID: <span t-field="o.partner_id.company_registry"/>
            </div>
        </xpath>

        <xpath expr="//div[@id='partner_vat_no_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                Company ID: <span t-field="o.partner_id.company_registry"/>
            </div>
        </xpath>

        <!-- on croatian invoices, unit of meassue must be always visible -->
        <xpath expr="//span[@t-field='line.product_uom_id']" position="replace">
            <t t-if="o.company_id.account_fiscal_country_id.code == 'HR'">
                <span t-field="line.product_uom_id">units</span>
            </t>
            <t t-else=""><span t-field="line.product_uom_id" groups="uom.group_uom">units</span></t>
        </xpath>

        <!-- show due date always -->
        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute name="t-if" add="(o.invoice_date_due and o.move_type == 'out_refund' and o.state == 'posted')" separator="or"/>
        </xpath>
    </template>

