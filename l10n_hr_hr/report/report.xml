<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <report
      id="employee_experience_report"
      model="hr.employee"
      string="Ispis staža zaposlenika"
      report_type="qweb-pdf"
      name="hr_hr.report_hr_employee_experience"
      file="hr_hr.report_hr_employee_experience"
      groups="hr.group_hr_user,l10n_hr_payroll_base.group_hr_payroll_user"
    />
  <!-- NOTE: the "name" and "file" attributes of "report" tag MUST BE NAMESPACED TO THE MODULE
    (see the addition of "hr_hr."-->
  <report
    id="employee_report"
    model="hr.employee"
    string="Ispis zaposlenika"
    report_type="qweb-pdf"
    name="hr_hr.report_hr_employee"
    file="hr_hr.report_hr_employee"
    groups="hr.group_hr_user"
  />

  <record id="report_hr_main_register" model="ir.actions.report">
    <field name="name">Employee Registry</field>
    <field name="model">hr.employee</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">l10n_hr_hr.hr_main_register_report</field>
    <field name="report_file">l10n_hr_hr.hr_main_register_report</field>
    <field name="print_report_name">'Employee Registry'</field>
    <field name="binding_model_id" ref="hr.model_hr_employee"/>
    <field name="binding_type">report</field>
</record>

  <report
    id="employee_contracts_within_date"
    model="hr.employee.registration.wizard"
    string="Employees contracts withing date limit"
    report_type="qweb-pdf"
    name="hr_hr.report_hr_employee_contracts"
    file="hr_hr.report_hr_employee_contracts"
    print_report_name="(object._get_report_base_filename())"
  />
  </data>
</odoo> 
