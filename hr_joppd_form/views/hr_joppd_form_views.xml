		<record id="hr_joppd_form_b_search_view" model="ir.ui.view">
			<field name="name">hr_joppd_form_b_search_view</field>
			<field name="model">hr.joppd.form.b</field>
			<field name="arch" type="xml">
				<search string="Search Naziv">
					<field string="Naziv" name="hr_employee_id" filter_domain="['|',('hr_employee_id','ilike',self),('hr_department','ilike',self)]" />
					<filter string="Uređivani podaci" name="user_edit" domain="[('user_edit','=',True)]"/>
					<filter string="Izvorni podaci" name="user_edit" domain="[('user_edit','=',False)]"/>				
					<separator />
					<group expand="0" string="Group By...">
						<filter string="Oznaka Stjecatelja" name="stjecatelj" context="{'group_by':'b61'}" />
						<filter string="Oznaka Primitka" name="primitak" context="{'group_by':'b62'}" />
					</group>
				</search>
			</field>
		</record>

		<record id="hr_joppd_form_B_action" model="ir.actions.act_window">
			<field name="name">Obrazac JOPPD strana B</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">hr.joppd.form.b</field>
			<field name="view_mode">list</field>		
			<field name="view_id" ref="hr_joppd_form_tree_view"/>
		</record>
    
    
