<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <menuitem
        id="menu_finance_config_croatia"
        name="Croatia settings"
        sequence="2"
        parent="account.menu_finance_configuration"
    />

    <!-- Fiskal Business Premise -->
<!--    TODO fiskal -> fiscal-->
    <record id="view_fiskal_premise_list" model="ir.ui.view">
        <field name="name">view_fiskal_premise_list</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="arch" type="xml">
            <list
                string="Business premises"
                decoration-success="l10n_hr_state == 'active'"
                decoration-warning="l10n_hr_state == 'close'"
                decoration-info="l10n_hr_state == 'pause'"
            >
                <field name="company_id" column_invisible="1" />
                <field name="l10n_hr_name" />
                <field name="l10n_hr_fiscal_code" />
                <field name="l10n_hr_invoice_sequence_by" />
                <field name="l10n_hr_lock" optional="hide" />
                <field name="l10n_hr_state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_fiskal_premise_form" model="ir.ui.view">
        <field name="name">view_fiskal_premise_form</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="button_activate_premise" 
                            string="Activate Premise" 
                            type="object" 
                            groups="account.group_account_manager" 
                            invisible="l10n_hr_state in ['active','close']"/>
                    <button name="button_pause_premise"  
                            string="Pause Premise" 
                            type="object"  
                            help="Use for temporary closing of premise, all related items will be modified according" 
                            groups="account.group_account_manager" 
                            invisible="l10n_hr_state not in ['active']"/>
                    <button name="button_close_premise" 
                            string="Close Premise" 
                            type="object" 
                            help="Use only is business premise is permanently closed,
                                  - All related PoS devices will be closed
                                  - All related PoS journals will be removed from dashboard, adn all related sequences will be archived
                                  - Once closed no more invoices should created for this premise"
                            groups="account.group_account_manager" 
                            invisible="l10n_hr_state != 'active'"/>
                    <field name="l10n_hr_state" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <field name="l10n_hr_lock" invisible="1"/>
                        <field name='l10n_hr_name' readonly="l10n_hr_lock"/>
                        <field name='l10n_hr_fiscal_code' readonly="l10n_hr_lock"/>
                        <field name="l10n_hr_invoice_sequence_by" readonly="l10n_hr_lock"/>
                        <field name="l10n_hr_invoice_place" readonly="l10n_hr_lock"/>
                        <field name="l10n_hr_sequence_id" domain="[('code','=','l10n_hr.fiscal')]">
                            <decorator name="invisible" options="{'l10n_hr_invoice_sequence_by': 'N', 'l10n_hr_fiscal_code': ''}"/>
                        </field>
                        <field name='company_id' invisible="1" />
                    </group>
                    <notebook name="hr_accounting" colspan="4">
                        <page string="Payment Devices In This Premise">
                            <field name="l10n_hr_fiscal_device_ids" nolabel="1" colspan="4">
                                <list string="PoS devices" editable="bottom">
                                    <field name="l10n_hr_name" />
                                    <field name="l10n_hr_business_premise_id" column_invisible="True"/>
                                    <field name="l10n_hr_fiscal_device_code" />
                                    <field name="l10n_hr_lock" optional="hide" />
                                    <field name="l10n_hr_invoice_place" optional="hide" />
                                    <field
                                        name="l10n_hr_journal_ids"
                                        widget="many2many_tags"
                                        domain="['&amp;',('type','=','sale'),'|',('l10n_hr_business_premise_id','=',False),('l10n_hr_business_premise_id','=', l10n_hr_business_premise_id)]"
                                    />
                                    <field name="l10n_hr_invoice_sequence_by" column_invisible="True" />
                                    <field name="l10n_hr_sequence_id" optional="hide" column_invisible="'l10n_hr_invoice_sequence_by' == 'P'"/>
                                    <field name="l10n_hr_state" widget="badge" />
                                    <button type="object" 
                                            name="button_activate_device" 
                                            class="btn-success" 
                                            icon="fa-play" 
                                            string="Activate" 
                                            invisible="l10n_hr_state not in ['draft','pause']"/>
                                    <button type="object" 
                                            string="Pause" 
                                            name="button_pause_device" 
                                            class="btn-danger" 
                                            icon="fa-pause" 
                                            invisible="l10n_hr_state != 'active'"/>
                                    <button type="object" 
                                            string="Close" 
                                            name="button_close_device" 
                                            class="btn-danger" 
                                            icon="fa-stop" 
                                            invisible="l10n_hr_state not in ['active','pause']"/>
                                </list>
                            </field>
                        </page>
                        <page string="Journals For This Premise" invisible="not l10n_hr_journal_ids">
                            <field name="l10n_hr_journal_ids" nolabel="1" colspan="4" options="{'no_create':True}" >
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" />
                                    <field name="journal_group_ids" widget="many2many_tags" readonly="1" optional="show" />
                                    <field name="currency_id" groups="base.group_multi_currency" optional="hide" />
                                    <field name="code" optional="show" />
                                    <field name="active" optional="hide" />
                                    <field name="show_on_dashboard" optional="hide" />
                                    <field name="company_id" groups="base.group_multi_company" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fiskal_premise" model="ir.actions.act_window">
        <field name="name">Business Premises</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_hr.business.premise</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_action_fiskal_premise"
        action="action_fiskal_premise"
        parent="menu_finance_config_croatia"
        sequence="1"
    />

    <!--Fiskal Device-->
    <record id="view_fiskal_device_list" model="ir.ui.view">
        <field name="name">view_fiskal_device_list</field>
        <field name="model">l10n_hr.fiscal.device</field>
        <field name="arch" type="xml">
            <list>
                <field name="l10n_hr_name" />
                <field name="l10n_hr_business_premise_id" />
                <field name="l10n_hr_fiscal_device_code" />
                <field name="l10n_hr_lock" />
                <field name="l10n_hr_state" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_fiskal_device_form" model="ir.ui.view">
        <field name="name">view_fiskal_device_form</field>
        <field name="model">l10n_hr.fiscal.device</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" 
                            name="button_activate_device" 
                            class="btn-success" 
                            icon="fa-play" 
                            string="Activate Device" 
                            invisible="l10n_hr_state not in ['draft','pause']"/>
                    <button type="object" 
                            name="button_pause_device" 
                            class="btn-danger" 
                            icon="fa-pause" 
                            string="Pause Device" 
                            invisible="l10n_hr_state != 'active'"/>
                    <button type="object" 
                            name="button_close_device" 
                            class="btn-danger" 
                            icon="fa-stop" 
                            string="Close Device" 
                            invisible="l10n_hr_state not in ['active','pause']"/>
                    <field name="l10n_hr_state" widget="statusbar"/>
                </header>
                <sheet>
                <group>
                    <field name="l10n_hr_business_premise_id" readonly="l10n_hr_lock"/>
                    <field name="l10n_hr_name" readonly="l10n_hr_lock"/>
                    <field name="l10n_hr_invoice_place" optional="hide"/>
                    <field name="l10n_hr_lock" readonly="1" invisible="1"/>
                    <field name="l10n_hr_invoice_sequence_by" readonly="1" invisible="1"/>
                    <field name="l10n_hr_fiscal_device_code" readonly="l10n_hr_lock"/>
                    <field name="l10n_hr_sequence_id" readonly="l10n_hr_lock" invisible="l10n_hr_invoice_sequence_by == 'P'"/>
                    <field name="l10n_hr_journal_ids" widget="many2many_tags" readonly="l10n_hr_lock"/>
                </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_fiskal_device" model="ir.actions.act_window">
        <field name="name">Payment Registers</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_hr.fiscal.device</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_action_fiskal_device"
        action="action_fiskal_device"
        parent="menu_finance_config_croatia"
        groups="base.group_no_one"
        sequence="2"
    />

</odoo>
