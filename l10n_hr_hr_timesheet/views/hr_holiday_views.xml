<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
<!-- VIEWS AND ACTION FOR HOLIDAY FORM IN TIMESHEET CONFIGURATION -->
        <record id="hr_holiday_tree_view" model="ir.ui.view">
            <field name="name">hr.holiday.tree.view</field>
            <field name="model">hr.holiday</field>
            <field name="arch" type="xml">
                <list string="Holidays">
                    <field name="name"/>
                    <field name="date"/>
                </list>
            </field>
        </record>

        <record id="hr_holiday_form_view" model="ir.ui.view">
            <field name="name">hr.holiday.form.view</field>
            <field name="model">hr.holiday</field>
            <field name="arch" type="xml">
                <form string="Holidays">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_hr_timesheet_holidays" model="ir.actions.act_window">
            <field name="name">Holidays</field>
            <field name="res_model">hr.holiday</field>
            <field name="view_mode">list,form</field>
            <field eval="False" name="view_id"/>
        </record>
<!-- END -->

<!-- VIEWS AND ACTION FOR HOLIDAY FORM IN HOLIDAY/LEAVES CONFIGURATION -->
        <record id="view_info3_holiday_form" model="ir.ui.view">
            <field name="name">info3.holiday.form</field>
            <field name="model">hr.holiday</field>
            <field name="arch" type="xml">
                <form string="Holidays">
                    <header>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_info3_holiday_tree" model="ir.ui.view">
                <field name="name">info3.holiday.tree</field>
                <field name="model">hr.holiday</field>
                <field name="arch" type="xml">
                    <list string="Holidays">
                        <field name="name"/>
                        <field name="date"/>
                    </list>
                </field>
            </record>

        <record id="open_view_info3_holiday" model="ir.actions.act_window">
            <field name="name">Holidays</field>
            <field name="res_model">hr.holiday</field>
            <field eval="False" name="view_id"/>
        </record>
<!-- END -->
    </data>
</odoo>