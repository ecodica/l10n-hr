<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="hr_payslip_email_template" model="mail.template">
            <field name="name">Payslip</field>
            <field name="model_id" ref="l10n_hr_payroll_base.model_hr_payslip"/>
            <field name="subject">{{object.company_id.name}} Payslip {{object.employee_id.name}}</field>
            <field name="partner_to">{{object.employee_id.partner_id.id}}</field>
            <field name="description">Sent manualy to employees</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Pozdrav,
        <br/><br/>
        U privitku je platna lista <strong>{{object.name}}</strong>

        iz poduzeća {{object.company_id.name}}.
        <br/><br/>
        Za eventualna pitanja nas slobodno kontaktirajte.
    </p>
</div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('l10n_hr_hr_payroll.ip1_form_report'))]"/>
            <field name="lang">{{ object.employee_id.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

    </data>
</odoo>
