<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_business_premise_form_view" model="ir.ui.view">
        <field name="name">l10n_hr_business_premise_form_view</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_fiscal_premise_form"/>
        <field name="arch" type="xml">
            <field name="l10n_hr_state" position="before">
                <button string="TEST ECHO" type="object" name="button_l10n_hr_test_fiscal_echo"
                        groups="base.group_no_one"/>
                <button string="Working Hours Fiscalization" type="object" class="btn-primary"
                        name="action_new_fiscal_operation"/>
            </field>
            <xpath expr="//sheet/group[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_open_fiscal_operations" type="object" class="oe_stat_button"
                            icon="fa-exchange" invisible="not fiscal_operation_count">
                        <field name="fiscal_operation_count" widget="statinfo" string="Fiscal Operations"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//field[@name='l10n_hr_fiscal_device_ids']//list/field[@name='l10n_hr_state']"
                   position="before">
                <field name="fiscalization_active" widget="boolean_toggle"/>
            </xpath>
            <button name="button_close_device" position="after">
                <button string="TEST ECHO" type="object" icon="fa-smile" class="btn-success"
                        invisible="not fiscalization_active" name="button_l10n_hr_test_fiscal_echo"
                        groups="base.group_no_one"
                />
            </button>
            <notebook position="inside">
                <page string="Fiscal Logs">
                    <field name="l10n_hr_fiscal_log_ids" nolabel="1" colspan="4"/>
                </page>
                <page string="Working Hours">
                    <group>
                        <separator string="Regulars"/>
                        <group>
                            <group>
                                <field name="regular_working_hours_valid_from" string="Valid From"/>
                            </group>
                            <group>
                                <field name="regular_working_hours_note" string="Note"/>
                            </group>
                        </group>
                        <field name="regular_working_hours_ids" nolabel="1" colspan="4"
                               context="{'default_type': 'regular', 'default_description': regular_working_hours_note,
                               'default_valid_from': regular_working_hours_valid_from, 'default_to_register': True}">
                            <list editable="bottom" delete="0">
                                <field name="dow"/>
                                <field name="description"/>
                                <field name="time_from" placeholder="08:00"/>
                                <field name="time_to" placeholder="16:00"/>
                                <field name="valid_from" required="1"/>
                                <field name="split_shift"/>
                                <field name="to_register"/>
                                <field name="to_remove"/>
                                <field name="type" column_invisible="1"/>
                            </list>
                        </field>
                        <separator string="Exceptions"/>
                        <group>
                        </group>
                        <field name="exception_working_hours_ids" nolabel="1" colspan="4"
                               context="{'default_type': 'exception', 'default_to_register': True}">
                            <list editable="bottom" delete="0">
                                <field name="dow"/>
                                <field name="time_from" placeholder="08:00"/>
                                <field name="time_to" placeholder="16:00"/>
                                <field name="valid_on" required="1"/>
                                <field name="split_shift"/>
                                <field name="to_register"/>
                                <field name="to_remove"/>
                                <field name="type" column_invisible="1"/>
                            </list>
                        </field>
                    </group>
                </page>
                <page string="Fiscal Operations">
                    <group>
                        <field name="last_fiscal_operation_id"/>
                    </group>
                    <field name="fiscal_operation_ids" nolabel="1" colspan="4" readonly="1"
                           domain="[('state', '!=', 'draft')]">
                        <list create="0" edit="0" delete="0" decoration-danger="state == 'error'">
                            <field name="execution_date"/>
                            <field name="operation"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="added_count" string="+"/>
                            <field name="removed_count" string="−"/>
                            <field name="changed_count" string="~"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'done'"
                                   decoration-danger="state == 'error'"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_working_hours_fiscalization" model="ir.actions.server">
        <field name="name">Working Hours Fiscalization</field>
        <field name="model_id" ref="l10n_hr_account_base.model_l10n_hr_business_premise"/>
        <field name="binding_model_id" ref="l10n_hr_account_base.model_l10n_hr_business_premise"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_new_fiscal_operation()</field>
    </record>

</odoo>
