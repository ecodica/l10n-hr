<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_invoice_document_advance_payment"
        inherit_id="account.report_invoice_document">

        <xpath expr="//div[@id='total']" position="before">
            <t t-if="o.advance_line_ids">
                <div class="ms-auto">
                    <h6>Advance payments</h6>
                    <table class="table table-sm table-borderless avoid-page-break-inside">
                        <t t-set="payments_vals" t-value="o.sudo().advance_line_ids"/>
                        <t t-foreach="payments_vals" t-as="payment_vals">
                            <tr>
                                <td>
                                    <i class="oe_form_field text-end oe_payment_label">Advance move <t t-out="payment_vals.advance_invoice_id.name"></t></i>
                                </td>
                                <td class="text-end">
                                    <span>Total: </span>
                                    <span t-out="payment_vals.amount"
                                        t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        <br/>
                                        <span>Base: </span>
                                        <span t-out="payment_vals.amount_untaxed"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        <br/>
                                        <span>Tax: </span>
                                        <span t-out="payment_vals.tax_amount"
                                            t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
