<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_croatian_payment_means_form" model="ir.ui.view">
        <field name="name">l10n_hr.account.payment.type.form</field>
        <field name="model">l10n_hr.account.payment.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group name="main">
                        <group name="main_left">
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="main_right">
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_croatian_payment_means_tree" model="ir.ui.view">
        <field name="name">l10n_hr.account.payment.type.tree</field>
        <field name="model">l10n_hr.account.payment.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_croatian_payment_means" model="ir.actions.act_window">
        <field name="name">Invoice Payment Means</field>
        <field name="res_model">l10n_hr.account.payment.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <menuitem action="action_croatian_payment_means" id="menu_croatian_payment_means" parent="menu_finance_config_croatia" sequence="10"/>
</odoo>
