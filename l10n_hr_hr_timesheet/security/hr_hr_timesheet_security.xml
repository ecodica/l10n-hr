<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="0">
    <record model="ir.module.category" id="module_category_hr_hr_timesheet">
      <field name="name">Timesheet</field>
      <field name="description">Restrictions on Timesheet menu</field>
      <field name="sequence">19</field>
    </record>

    <record model="ir.module.category" id="module_category_hr_hr_timesheet_absence">
      <field name="name">Timesheet - other</field>
      <field name="sequence">20</field>
    </record>

    <record id="group_hr_hr_timesheet_user" model="res.groups">
        <field name="name">Officer</field>
        <field name="category_id" ref="module_category_hr_hr_timesheet"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_hr_hr_timesheet_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_hr_hr_timesheet"/>
        <field name="implied_ids" eval="[(4, ref('l10n_hr_hr_timesheet.group_hr_hr_timesheet_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_hr_hr_timesheet_receive_notification" model="res.groups">
        <field name="name">Receive notification about unjustified absence</field>
        <field name="category_id" ref="module_category_hr_hr_timesheet_absence"/>
        <field name="comment">The user will receive an email notification about employee's unjustified absence.</field>
    </record>

  </data>
</odoo>
