<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="l10n_hr_report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-set='layout_document_title']/span[last()]" position="replace">
            <t t-if="o.country_code == 'HR'">
                <span t-if="o.name != '/'" t-field="o.l10n_hr_fiscal_number" />
            </t>
            <t t-else="">
                <span t-if="o.name != '/'" t-field="o.name" />
            </t>
        </xpath>

        <!-- add croatia fiscal required data after total line -->
        <xpath expr="//div[@id='total']/.." position="after">
            <t t-if="o.country_code == 'HR'">
                <div id="l10n_hr_info" class="row mt-4 mb-4">
                    <div
                        class="col-auto col-3 mw-100 mb-2 px-1"
                        t-if="o.l10n_hr_payment_method"
                        name="l10n_hr_payment_method"
                    >
                        <strong>Payment means:</strong>
                        <p class="m-0" t-field="o.l10n_hr_payment_method" />
                    </div>
                    <div
                        class="col-auto col-3 mw-100 mb-2 px-1"
                        t-if="o.l10n_hr_fiscal_device_id.l10n_hr_invoice_place != '' or o.l10n_hr_fiscal_device_id.l10n_hr_business_premise_id.l10n_hr_invoice_place!= ''"
                        name="l10n_hr_invoice_place"
                    >
                        <strong>Place of issue:</strong>
                        <p
                            class="m-0"
                            t-esc="o.l10n_hr_fiscal_device_id.l10n_hr_invoice_place or o.l10n_hr_fiscal_device_id.l10n_hr_business_premise_id.l10n_hr_invoice_place"
                        />
                    </div>
                    <div
                        class="col-auto col-3 mw-100 mb-2 px-1"
                        t-if="o.l10n_hr_fiscal_time"
                    >
                        <strong>Confirmation time:</strong>
                        <p class="m-0" t-field="o.l10n_hr_fiscal_time" />
                    </div>
                    <div
                        class="col-auto col-3 mw-100 mb-2 px-1"
                        t-if="o.name and o.name != o.l10n_hr_fiscal_number"
                        name="l10n_hr_internal_number"
                    >
                        <strong>Internal number:</strong>
                        <p class="m-0" t-field="o.name" />
                    </div>
                </div>
            </t>
        </xpath>

        <xpath expr="//div[@id='partner_vat_address_not_same_as_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                <div id="company_registry_nsa">
                    Company ID: <span t-field="o.partner_id.company_registry"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@id='partner_vat_address_same_as_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                <div id="company_registry_sa">
                    Company ID: <span t-field="o.partner_id.company_registry"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//div[@id='partner_vat_no_shipping']" position="before">
            <div t-if="o.partner_id.company_registry and o.company_id.country_code == 'HR'">
                <div id="company_registry_ns">
                    Company ID: <span t-field="o.partner_id.company_registry"/>
                </div>
            </div>
        </xpath>

        <!-- on croatian invoices, unit of measure must be always visible -->
        <xpath expr="//span[@t-field='line.product_uom_id']" position="replace">
            <t t-if="o.company_id.account_fiscal_country_id.code == 'HR'">
                <span t-field="line.product_uom_id">units</span>
            </t>
            <t t-else=""><span t-field="line.product_uom_id" groups="uom.group_uom">units</span></t>
        </xpath>

        <!-- show due date always -->
        <xpath expr="//div[@name='due_date']" position="attributes">
            <attribute name="t-if" add="(o.invoice_date_due and o.move_type == 'out_refund' and o.state == 'posted')" separator="or"/>
        </xpath>
    </template>

    <template id="l10n_hr_document_tax_totals" inherit_id="account.document_tax_totals">
        <!-- storno hack adding minus to tax totals on printed report -->
        <xpath expr="//tr[hasclass('o_subtotal')]/td[hasclass('text-end')]/span[contains(@t-out, subtotal['base_amount_currency'])]" position="attributes">
            <attribute name="t-out">subtotal['base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[contains(@t-if, tax_group['display_base_amount_currency'])]/td[2]/span[contains(@t-out, tax_group['tax_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_group['tax_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[@t-else='']/td[2]/span[contains(@t-out, tax_group['tax_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_group['tax_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[@t-else='']/td[2]/span[contains(@t-out, tax_group['display_base_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_group['display_base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[contains(@t-if, 'cash_rounding_base_amount_currency')]/td[2]/span[contains(@t-out, tax_totals['cash_rounding_base_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_totals['cash_rounding_base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[2]/strong[contains(@t-out, tax_totals['total_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_totals['total_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
    </template>

</odoo>
