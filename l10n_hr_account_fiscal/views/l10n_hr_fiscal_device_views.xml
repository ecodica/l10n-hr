<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_fiscal_device_list_view" model="ir.ui.view">
        <field name="name">l10n_hr_fiscal_device_list_view</field>
        <field name="model">l10n_hr.fiscal.device</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_fiscal_device_form"/>
        <field name="arch" type="xml">
            <field name="l10n_hr_journal_ids" position="after">
                <label for="fiscalization_active"/>
                <div class="o_row">
                    <field name="fiscalization_active" widget="boolean_toggle"/>
                    <button string="TEST ECHO" type="object" name="button_l10n_hr_test_fiscal_echo" colspan="2"/>
                </div>
            </field>
        </field>
    </record>

    <record id="l10n_hr_fiscal_device_form_view" model="ir.ui.view">
        <field name="name">l10n_hr_fiscal_device_form_view</field>
        <field name="model">l10n_hr.fiscal.device</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_fiscal_device_form"/>
        <field name="arch" type="xml">
            <field name="l10n_hr_journal_ids" position="after">
                <field name="enable_fiscalize_on_confirm"/>
                <field name="enable_cron_fiscalization"/>
                <field name="cron_fiscalization_delay_hours" invisible="not enable_cron_fiscalization"/>
            </field>
        </field>
    </record>

</odoo>
