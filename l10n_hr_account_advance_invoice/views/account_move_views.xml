<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="act_advance_invoice_advance_line_list" model="ir.actions.act_window">
        <field name="res_model">account.move.advance.line</field>
        <field name="name">Advance lines</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('advance_invoice_id', '=', active_id)]</field>
    </record>

    <record id="account_move_advance_line_tree_view" model="ir.ui.view">
        <field name="name">Advance line</field>
        <field name="model">account.move.advance.line</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" delete="false">
                <field name="advance_invoice_id"/>
                <field name="invoice_id"/>
                <field name="amount" sum="Sum"/>
                <field name="amount_untaxed" sum="Sum"/>
                <field name="tax_amount" sum="Sum"/>
                <field name="storno_move_id" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="account_move_inherit_advance_invoice" model="ir.ui.view">
        <field name="name">account_move_inherit_advance_invoice</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Advance" invisible="(move_type and move_type not in ['out_invoice'])">
                    <group>
                        <field name="advance_invoice" readonly="state != 'draft'" />
                        <field name="advance_account_id" readonly="state != 'draft'" required="1" invisible="advance_invoice == False"/>
                        <field name="is_advance_reconciled" invisible="advance_invoice == False"/>
                        <!-- show advance lines where current advance invoice was used -->
                        <button
                            name="%(act_advance_invoice_advance_line_list)d"
                            string="Show storno lines"
                            type="action"
                            invisible="advance_invoice == False"
                            help="Show advance lines where this invoice was used for storno."
                        />
                    </group>
                    <group invisible="advance_invoice == True">
                        <field name="advance_line_ids" readonly="state != 'draft'">
                        <tree editable="bottom">
                            <field name="advance_invoice_id"
                                domain="[('advance_invoice', '=', True), ('partner_id', '=', parent.partner_id), ('move_type', '=', 'out_invoice'),
                                            ('id', '!=', parent.id), ('amount_total', '&gt;', 0), ('state', 'not in', ['draft', 'cancel']),
                                            ('is_advance_reconciled', '=', False)]"
                                options="{'limit': 10, 'create': false, 'create_edit': false, 'm2o_dialog': false}"/>
                            <field name="available_line_ids" column_invisible="1"/>
                            <field name="advance_move_storno_line_id"/>
                            <field name="amount" sum="Sum"/>
                            <field name="amount_untaxed" sum="Sum"/>
                            <field name="tax_amount" sum="Sum"/>
                            <field name="storno_move_id" readonly="1"/>
                        </tree>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
    
</odoo>
