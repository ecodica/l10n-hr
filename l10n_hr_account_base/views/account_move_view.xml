<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_hr_move_form" model="ir.ui.view">
        <field name="name">view_l10n_hr_move_form</field>
        <field name="model">account.move</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">

            <widget name="web_ribbon" position="before">
                <!-- friendly warning to visaulise if journal is not ready -->
                <widget
                    name="web_ribbon"
                    title="PoS not ready!"
                    bg_color="bg-danger"
                    invisible ="country_code != 'HR' or (move_type and move_type not in ['out_invoice', 'out_refund']) or l10n_hr_allowed_fiscal_device_ids"
                    tooltip="In order to validate invoice, you need activated pos device, Check business premises and registers settings"
                />
            </widget>
            <field name="name" position="after">
                <span class="oe_inline">
                    <label string="HR - Fiskal Number" for="l10n_hr_fiscal_number" invisible ="not l10n_hr_fiscal_number" />
                    <field name="l10n_hr_fiscal_number" readonly ="state != 'draft'" nolabel="1" invisible ="not l10n_hr_fiscal_number" />
                </span>
            </field>
            <notebook position="inside">
                <page string="Croatia Fiskal Data" name="croatia" invisible="(country_code != 'HR') or (move_type and move_type not in ['out_invoice', 'out_refund'])">
                    <!-- invisible fields -->
                    <group>
                        <group name="l10n_hr_base_fiskal">
                            <field name="l10n_hr_show_required_fisk_fields_on_header" invisible="1"/>
                            <field name="l10n_hr_date_document" readonly ="state != 'draft'"/>
                            <field name="l10n_hr_invoice_time" readonly="1"/>
                            <field name="l10n_hr_allowed_fiscal_device_ids" invisible="1"/>
                            <field name="l10n_hr_fiscal_device_visible" invisible="1" />
                            <field name="l10n_hr_fiscal_device_id" widget="selection" invisible ="not l10n_hr_fiscal_device_visible or l10n_hr_show_required_fisk_fields_on_header " domain="[('id', 'in', l10n_hr_allowed_fiscal_device_ids)]" readonly="state != 'draft'"/>
                            <!-- until fiscalisation module for cash payments has only one selectable ooption -->
                            <field name="l10n_hr_payment_method" invisible="move_type not in ['out_invoice','out_refund'] or l10n_hr_show_required_fisk_fields_on_header" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </page>
            </notebook>

            <field name="invoice_vendor_bill_id" position="after">
                <field name="l10n_hr_fiscal_device_id" widget="selection" invisible="not l10n_hr_fiscal_device_visible or not l10n_hr_show_required_fisk_fields_on_header" domain="[('id', 'in', l10n_hr_allowed_fiscal_device_ids)]" readonly="state != 'draft'"/>
                <field name="l10n_hr_payment_method" invisible="move_type not in ['out_invoice','out_refund'] or not l10n_hr_show_required_fisk_fields_on_header" readonly="state != 'draft'"/>
            </field>

            <field name="ref" position="before">
                <field name="l10n_hr_is_ref_required" invisible="1"/>
            </field>
            <field name="ref" position="attributes">
                <attribute name="required">l10n_hr_is_ref_required</attribute>
            </field>

        </field>
    </record>

    <record id="view_l10n_hr_out_invoice_tree" model="ir.ui.view">
        <field name="name">view.l10n_hr.out.invoice.tree</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_hr_fiscal_number" optional="hide"/>
                <field name="l10n_hr_fiscal_device_id" optional="hide" readonly="state != 'draft'" />
            </field>
        </field>
    </record>

    <!-- onboarding -->
    <!-- TODO migrate into 17.0 -->
    <template id="onboarding_business_premise_step">
        <t t-call="onboarding.onboarding_step">
            <t t-set="title">Business Premise</t>
            <t t-set="description">
                Setup your business premises and PoS devices
            </t>
            <t t-set="btn_text">Add Business Premise</t>
            <t t-set="done_text">Premise added!</t>
            <t t-set="method" t-value="'setting_init_bank_account_action'" />
            <t t-set="model" t-value="'l10n_hr.business.premise'" />
            <t t-set="state" t-value="state.get('account_setup_premise_state')" />
        </t>
    </template>
    <!-- TODO: add onboarding step! -->

</odoo>
