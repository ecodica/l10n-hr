<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="tax_deduction_tree_view" model="ir.ui.view">
            <field name="name">tax.deduction.tree.view</field>
            <field name="model">tax.deduction</field>
            <field name="arch" type="xml">
                <list string="Odbitak poreza" default_order="sequence" editable="top">
                    <field name="name"/>
                    <field name="tax_deduction_coef"/>
                    <field name="status"/>
                </list>
            </field>
        </record>

        <record id="tax_deduction_action" model="ir.actions.act_window">
            <field name="name">Odbitak poreza</field>
            <field name="res_model">tax.deduction</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>
