<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="l10n_hr_account_invoice_tips_fiskal.not_fiscalized_invoices_systray" t-inherit="l10n_hr_account_fiskal.not_fiscalized_invoices_systray" t-inherit-mode="extension">
        <xpath expr="//DropdownItem" position="after">
            <t t-if="state.counterTips">
                <DropdownItem>
                    <div t-on-click="_openNotFiscalizedTips" class="d-flex justify-content-between align-items-center">
                        <span class="o-mail-NotificationItem-name text-truncate fw-bold mb-0 px-3">Not Fiscalized Tips</span>
                        <span class="rounded-pill px-2" style="color: white!important; background-color: red!important;">
                            <t t-esc="state.counterTips"/>
                        </span>
                    </div>
                </DropdownItem>
            </t>
        </xpath>
    </t>
</templates>
