<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="l10n_hr_fiskal_report_invoice_document"
        inherit_id="l10n_hr_account_base.l10n_hr_report_invoice_document"
    >

        <!-- fiscal user must be shown on croatian invoices -->
        <xpath expr="//div[@id='l10n_hr_info']/div[@name='interni_broj']" position="after">
            <div
                class="col-auto col-3 mw-100 mb-2"
                t-if="o.l10n_hr_fiskal_user_id"
                name="l10n_hr_fiskal_user_id"
            >
                <strong>Fiscal User:</strong>
                <p class="m-0" t-field="o.l10n_hr_fiskal_user_id.display_name" />
            </div>
        </xpath>
        <!-- hide taxes if company is not in tax system -->
        <xpath expr="//th[@name='th_taxes']" position="attributes">
            <attribute name="t-if">o.company_id.l10n_hr_fiskal_taxative</attribute>
        </xpath>
        <xpath expr="//span[@id='line_tax_ids']/.." position="attributes">
            <attribute name="t-if">o.company_id.l10n_hr_fiskal_taxative</attribute>
        </xpath>

        <!-- add croatia fiskal required data after total line -->
        <xpath expr="//div[@id='l10n_hr_info']/.." position="after">
            <div
                t-if="o.country_code == 'HR'"
                id="l10n_hr_fiskal_info"
                class="row mt-4 mb-4"
            >
                <div class="col-auto col-8 mw-100 mb-2">
                    <div t-if="o.l10n_hr_zki" name="zki">
                        <strong>ZKI:</strong>
                        <span class="m-0" t-field="o.l10n_hr_zki" />
                    </div>
                    <div t-if="o.l10n_hr_jir" name="jir">
                        <strong>JIR:</strong>
                        <span class="m-0" t-field="o.l10n_hr_jir" />
                    </div>
                    <div t-if="o.l10n_hr_fiskal_qr">
                        <strong>Scan me to validate -&gt;</strong>
                    </div>
                </div>
                <div
                    id="l10n_fiskal_qr"
                    class="col-auto col-4 mw-100 mb-2"
                    t-if="o.l10n_hr_fiskal_qr"
                >
                    <img
                        class="border border-dark rounded"
                        style="max-width: 120px; max-height: 120px;"
                        t-att-src="'data:image/png;base64,%s' % o.l10n_hr_fiskal_qr.decode('ascii')"
                    />
                </div>
            </div>
        </xpath>

    </template>

    <!-- hide tax subtotals if company is not taxative -->
    <!-- TODO: move to some lower module or new module that will handle not taxable companies -->
    <template id="document_tax_totals_template_inherited" inherit_id="account.document_tax_totals_template">
         <xpath expr="//t[@t-call='account.tax_groups_totals']" position="replace">

            <t t-if="not tax_totals.get('l10n_hr_fiskal_taxative',True)"></t>
            <t t-else="">
                <t t-call="account.tax_groups_totals"/>
            </t>
         </xpath>
    </template>

    <!-- TODO: CONFIG THIS -> style="max-width: 80px; max-height: 80px;" -->
</odoo>
