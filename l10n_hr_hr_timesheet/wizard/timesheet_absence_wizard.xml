<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_timesheet_absence_report" model="ir.ui.view">
        <field name="name">Employee absence report</field>
        <field name="model">timesheet.absence.wizard</field>
        <field name="arch" type="xml">
            <form string="Employee absence wizard" >
                <group>
                    <label for="date_from" string="Date range" class="oe_inline"/>
                    <div class="oe_row">
                        <div>
                            <field name="date_from" class="oe_inline"/>
                            -
                            <field name="date_to" class="oe_inline"/>
                        </div>
                    </div>
                </group>
                <footer>
                  <button name="print_report" string="Print" type="object" class="oe_highlight"/>
                  <button string="Cancel" class="btn btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_timesheet_absent_employees_report" model="ir.actions.act_window">
        <field name="name">Employee absence report</field>
        <field name="res_model">timesheet.absence.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="hr_timesheet_absence_report"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_hr_timesheet_absence_report"
        name="Unjustified absences"
        parent="l10n_hr_hr_timesheet.menu_reports"
        sequence="70"
        action="action_timesheet_absent_employees_report"
        groups="l10n_hr_hr_timesheet.group_hr_hr_timesheet_receive_notification"
         />

</odoo>