<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_annual_calculation_wizard" model="ir.ui.view">
      <field name="name">view.annual.calculation.wizard</field>
      <field name="model">annual.calculation.wizard</field>
      <field name="arch" type="xml">
        <form string="Godišnji obračun">
            <group colspan="4" >
              <separator string="Zaposlenici" colspan="4"/>
              <newline/>
              <field name="employee_ids" colspan="4" nolabel="1"/>
            </group>
          <footer>
            <button string="Godišnji obračun" name="do_annual_calculation" type="object" class="oe_highlight"/>
            <button string="Odustani" special="cancel" class="oe_link"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_annual_calculation_wizard" model="ir.actions.act_window">
      <field name="name">Annual calculation wizard</field>
      <field name="res_model">annual.calculation.wizard</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="view_annual_calculation_wizard"/>
      <field name="target">new</field>
    </record>

  </data>
</odoo>