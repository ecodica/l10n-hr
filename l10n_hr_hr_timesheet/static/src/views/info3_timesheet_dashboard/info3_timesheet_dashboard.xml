<?xml version="1.0" encoding="UTF-8"?>
<templates>
    <t t-name="l10n_hr_hr_timesheet.Info3TimesheetDashboard">
        <div class="info3-timesheet-dashboard pt-4 pb-2 border-bottom border-gray d-flex flex-row align-items-end justify-content-center">
            <div class="buttons-start d-flex flex-row flex-nowrap gap-1">
                <button class="btn btn-md btn-info" t-on-click="this.onClickPrintReportSum">Print summarized report</button>
                <button class="btn btn-md btn-info" t-on-click="this.onClickPrintReport">Print detailed report</button>
            </div>
            <div class="filters d-flex flex-row flex-nowrap">
                <div class="mx-1">
                    <label class="fw-bold">Day:</label>
                    <select class="form-select form-control-md bg-white"
                        t-on-change="(ev) => this.onChangeDay(ev)"
                        t-att-value="this.state.current_day"
                    >
                        <option></option>
                        <t t-foreach="this.state.days" t-as="day" t-key="day.key">
                            <option  t-att-value="day.value" t-esc="day.value"></option>
                        </t>
                    </select>
                </div>

                <div class="mx-1">
                    <label class="fw-bold">Month:</label>
                    <select class="form-select form-control-md bg-white"
                        t-on-change="(ev) => this.onChangeMonth(ev)"
                        t-att-value="this.state.current_month"
                    >
                        <option></option>
                        <t t-foreach="this.months" t-as="month" t-key="month">
                            <option t-att-value="month" t-esc="month"></option>
                        </t>
                    </select>
                </div>

                <div class="mx-1">
                    <label class="fw-bold">Year:</label>
                    <select class="form-select form-control-md bg-white"
                        t-on-change="(ev) => this.onChangeYear(ev)"
                        t-att-value="this.state.current_year"
                    >
                        <option></option>
                        <t t-foreach="this.years" t-as="year" t-key="year">
                            <option t-att-value="year" t-esc="year"></option>
                        </t>
                    </select>
                </div>

                <div class="mx-1">
                    <label class="fw-bold">Department:</label>
                    <select class="form-select form-control-md bg-white" t-on-change="(ev) => this.onChangeDepartment(ev)">
                        <option></option>
                        <t t-foreach="this.departments" t-as="department" t-key="department.id">
                            <option t-att-value="department.id" t-esc="department.name"></option>
                        </t>
                    </select>
                </div>

                <div class="mx-1">
                    <label class="fw-bold">Employee filter :</label>
                    <select class="form-select form-control-md bg-white" t-on-change="(ev) => this.onChangeEmployeeFilter(ev)">
                        <option value="active">Show active only</option>
                        <option value="inactive">Show inactive only</option>
                        <option value="active_and_inactive">Show both active and inactive</option>
                    </select>
                </div>

                <div class="mx-1" style ="width : 250px">
                    <label class="fw-bold">Based on department filter:</label>
                    <select class="form-select form-control-md bg-white" t-on-change="(ev) => this.onChangeDepartmentFilter(ev)">
                        <option value="current_dep_only">Show current department only</option>
                        <option value="has_dep_records">Has department records</option>
                        <option value="current_and_has_records">Show both options</option>
                    </select>
                </div>

                <div class="mx-1">
                    <label class="fw-bold">Employee:</label>
                    <select class="form-select form-control-md bg-white" t-on-change="(ev) => this.onChangeEmployee(ev)">
                        <option></option>
                        <t t-foreach="this.state.filtered_employees" t-as="employee" t-key="employee.id">
                            <option t-att-value="employee.id" t-esc="employee.name" t-att-class="employee.class"></option>
                        </t>
                    </select>
                </div>
            </div>
            <!-- commented out because it is not yet in function -->
            <!-- <div class="oe_form_dropdown_section">
              <h4>Analytic account :</h4> <select class="oe_info3_timesheet_select_analytic_account"></select>
            </div> -->
            <div class="buttons-end d-flex flex-row flex-nowrap gap-1">
                <button class="btn btn-md btn-primary" t-on-click="this.onClickAddEmployees">Add employees</button>
                <button class="btn btn-md btn-primary" t-on-click="this.onClickRefreshForm">Refresh form</button>
                <button class="btn btn-md btn-primary" t-on-click="this.onClickGetWorkTimeControl">Work time control</button>
                <button class="btn btn-md btn-primary" t-on-click="this.onClickAutofill">Autofill</button>
            </div>

        </div>
    </t>
</templates>
