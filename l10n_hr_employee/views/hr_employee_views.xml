<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_l10n_hr_employee" model="ir.ui.view">
        <field name="name">"view_employee_form_l10n_hr_employee"</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']//field[@name='private_email']" position="after">
                <field name="l10n_hr_oib" required="company_country_code=='HR'"/>
            </xpath>
        </field>

    </record>

</odoo>