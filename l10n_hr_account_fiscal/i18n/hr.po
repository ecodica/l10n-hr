#. module: l10n_hr_account_fiscal
#: model:ir.model.fields,help:l10n_hr_account_fiscal.field_l10n_hr_change_fiscal_data__l10n_hr_payment_method
msgid ""
"According to Fiscalization Law and regulative there are 4 possible options: \n"
"G - Cash (coins or bills), fiscalization required\n"
"K - Bank cards, fiscalization required\n"
"T - Transaction bank account\n"
"O - Other payment, fiscalization required\n"
msgstr ""
"Prema Zakonu o fiskalizaciji postoje 4 mogućnosti: \n"
"G - Gotovina (novčanice i kovanice), obavezna fiskalizacija\n"
"K - Bankovne kartice, obavezna fiskalizacija\n"
"T - Transakcijski račun\n"
"O - Ostali načini plaćanja, obavezna fiskalizacija\n"

