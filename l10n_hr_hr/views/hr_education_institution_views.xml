<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="education_institution_form_view_ui" model="ir.ui.view">
            <field name="name">hr.education.institution.form</field>
            <field name="model">hr.education.institution</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                        <field name="code"/>
                        <field name="name"/>
                            <label for="street" string="Address"/>
                                <div class="o_address_format">
                                    <field name="addr_type" placeholder="Address Type"/>
                                    <field name="street" placeholder="Street..." class="o_address_street" />
                                    <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city" options='{"no_open": True}'/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip" />
                                    <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                </div>
                        <field name="phone"/>
                        <field name="institution_description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="education_institution_tree_view_ui" model="ir.ui.view">
            <field name="name">hr.education.institution.tree</field>
            <field name="model">hr.education.institution</field>
            <field name="arch" type="xml">
                <list>
                    <field name="code"/>
                    <field name="name"/>
                    <field name="street" string="Address"/>
                    <field name="phone"/>
                    <field name="institution_description"/>
                </list>
            </field>
        </record>

        <record id="open_view_education_institution" model="ir.actions.act_window">
            <field name="name">Education Institution</field>
            <field name="res_model">hr.education.institution</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
        id="menu_view_education_institution"
        action="open_view_education_institution"
        parent="hr_submenu_view_employees"
        sequence="20"/>

</odoo>
