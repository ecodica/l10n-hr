<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- hr.department -->
        <record id="hr_payroll_department_form_view" model="ir.ui.view">
            <field name="name">hr.payroll.department.form</field>
            <field name="model">hr.department</field>
            <field name="inherit_id" ref="hr.view_department_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet/group/field[@name='parent_id']" position="after">
                    <field name="manager_add_on_timesheet"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
