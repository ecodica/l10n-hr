<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="not_fiscalized_invoices_systray">
        <t t-if="state.counterTotal">
            <Dropdown position="'bottom-end'">
                <button class="new_icon btn o-dropdown-caret-none" aria-label="Not Fiscalized Invoices">
                    <i id='open_not_fiscalized_invoices'
                       class="fa fa-file-text fa-1.5x"
                       role="img" aria-label="Not Fiscalized Invoices"/>
                    <span class="badge rounded-pill"><t t-esc="state.counterTotal"/></span>
                </button>
                <t t-set-slot="content">
                    <t t-if="state.counterInvoice">
                        <DropdownItem onSelected.bind="_openNotFiscalizedInvoices">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="o-mail-NotificationItem-name text-truncate fw-bold mb-0 px-3">Not Fiscalized Invoices</span>
                                <span class="badge rounded-pill px-2" style="color: white!important; background-color: red!important;">
                                    <t t-esc="state.counterInvoice"/>
                                </span>
                            </div>
                        </DropdownItem>
                    </t>
                </t>
            </Dropdown>
        </t>
    </t>
</templates>
