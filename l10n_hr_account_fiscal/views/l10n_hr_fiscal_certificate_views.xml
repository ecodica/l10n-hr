<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_fiscal_certificate_list_view" model="ir.ui.view">
        <field name="name">l10n_hr_fiscal_certificate_list_view</field>
        <field name="model">l10n_hr.fiscal.certificate</field>
        <field name="type">list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="cert_type"/>
                <field name="schema"/>
                <field name="not_before"/>
                <field name="not_after"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="10n_hr_fiscal_certificate_form_view" model="ir.ui.view">
        <field name="name">10n_hr_fiscal_certificate_form_view</field>
        <field name="model">l10n_hr.fiscal.certificate</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Convert certificate" type="object" name="button_convert_p12"
                            invisible="state != 'draft' or (not cert_file)"/>
                    <button string="Approve" type="object" name="action_validate" invisible="state != 'convert'"/>
                    <button string="Cancel" type="object" name="action_cancel"
                            invisible="(state != 'convert') or (state != 'active')"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group colspan="4" col="4">
                        <field name="name"/>
                        <field name="cert_file" filename="cert_file_name"/>
                        <field name="cert_file_name" invisible="1" class="oe_inline oe_right"/>
                        <field name="cert_password" invisible="state != 'draft'"/>
                    </group>
                    <group invisible="not cert_type">
                        <group>
                            <field name="cert_subject"/>
                            <field name="cert_vat"/>
                            <field name="cert_issuer"/>
                        </group>
                        <group>
                            <field name="cert_type"/>
                            <field name="schema"/>
                            <field name="not_before"/>
                            <field name="not_after"/>
                        </group>
                        <group>
                            <field name="pem_key"/>
                        </group>
                        <group>
                            <field name="pem_crt"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_l10n_hr_fiscal_certificate" model="ir.actions.act_window">
        <field name="name">Fiscal Certificates</field>
        <field name="res_model">l10n_hr.fiscal.certificate</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="l10n_hr_fiscal_certificate_list_view"/>
    </record>

    <menuitem
            id="menu_action_certificate_tree"
            action="action_l10n_hr_fiscal_certificate"
            sequence="10"
            parent="l10n_hr_account_base.menu_finance_config_croatia"
    />

</odoo>
