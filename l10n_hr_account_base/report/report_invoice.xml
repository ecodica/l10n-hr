    <template id="l10n_hr_document_tax_totals" inherit_id="account.document_tax_totals">
            <!-- storno hack
                adding minus to tax totals on printed report
        -->
        <xpath expr="//tr[hasclass('o_subtotal')]/td[hasclass('text-end')]/span[contains(@t-out, subtotal['base_amount_currency'])]" position="attributes">
            <attribute name="t-out">subtotal['base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[contains(@t-if, tax_group['display_base_amount_currency'])]/td[2]/span[contains(@t-out, tax_group['tax_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_group['tax_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_taxes')]/t[@t-else='']/td[2]/span[contains(@t-out, tax_group['tax_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_group['tax_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[contains(@class, 'o_taxes')]//t[@t-else]//td[1]/span[contains(@t-out, &quot;tax_group['display_base_amount_currency']&quot;)]" position="attributes">
            <attribute name="t-out">tax_group['display_base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[contains(@t-if, 'cash_rounding_base_amount_currency')]/td[2]/span[contains(@t-out, tax_totals['cash_rounding_base_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_totals['cash_rounding_base_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
        <xpath expr="//tr[hasclass('o_total')]/td[2]/strong[contains(@t-out, tax_totals['total_amount_currency'])]" position="attributes">
            <attribute name="t-out">tax_totals['total_amount_currency'] * (-1 if tax_totals['l10n_hr_is_storno'] else 1)</attribute>
        </xpath>
    </template>

