<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="l10n_hr_fiscal_report_invoice_document"
        inherit_id="l10n_hr_account_base.l10n_hr_report_invoice_document"
    >

        <!-- fiscal user must be shown on croatian invoices -->
        <xpath expr="//div[@name='l10n_hr_invoice_user']" position="after">
            <div
                class="col-4 float-left mb-2 px-1"
                t-if="o.country_code == 'HR' and o.l10n_hr_fiscal_user_id"
                style="width: 33.3% !important; float: left !important; min-height: 55px;"
                name="l10n_hr_fiscal_user_id"
            >
                <strong>Fiscal User:</strong>
                <p class="m-0" t-field="o.l10n_hr_fiscal_user_id.display_name" />
            </div>
        </xpath>
        <!-- invoice user must not be shown on croatian invoices where fiscal user is written-->
        <xpath expr="//div[@name='l10n_hr_invoice_user']" position="replace">
            <div class="col-4 float-left mb-2 px-1"
                 style="width: 33.3% !important; float: left !important; min-height: 55px;"
                 t-if="o.country_code == 'HR' and o.invoice_user_id and not o.l10n_hr_fiscal_user_id"
                 name="l10n_hr_invoice_user"
            >
                <strong>Responsible person:</strong>
                <p class="m-0" t-field="o.invoice_user_id.display_name" />
            </div>
        </xpath>

        <!-- add croatia fiscal required data after total line -->
        <xpath expr="//div[@id='l10n_hr_info']/.." position="after">
            <div
                t-if="o.country_code == 'HR'"
                id="l10n_hr_fiscal_info"
                class="row mt-4 mb-4"
            >
                <div class="col-auto col-8 mw-100 mb-2">
                    <div t-if="o.l10n_hr_zki" name="zki">
                        <strong>ZKI:</strong>
                        <span class="m-0" t-field="o.l10n_hr_zki" />
                    </div>
                    <div t-if="o.l10n_hr_jir" name="jir">
                        <strong>JIR:</strong>
                        <span class="m-0" t-field="o.l10n_hr_jir" />
                    </div>
                    <div t-if="o.l10n_hr_fiscal_qr" id="l10n_hr_note">
                        <strong>Scan me to validate -&gt;</strong>
                    </div>
                </div>
                <div
                    id="l10n_fiscal_qr"
                    class="col-auto col-4 mw-100 mb-2"
                    t-if="o.l10n_hr_fiscal_qr"
                >
                    <img
                        class="border border-dark rounded"
                        style="max-width: 120px; max-height: 120px;"
                        t-att-src="'data:image/png;base64,%s' % o.l10n_hr_fiscal_qr.decode('ascii')"
                    />
                </div>
            </div>
        </xpath>

    </template>

</odoo>
