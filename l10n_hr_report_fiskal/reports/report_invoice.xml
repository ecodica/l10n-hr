<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="l10n_hr_report_fiskal.report_invoice_show_payment_terms_for_fiscal_only" 
              inherit_id="l10n_hr_account_reference.report_invoice_payment_reference_layout">
        <xpath expr="//p[@name='payment_communication']" position="replace">
            <t t-if="not o.l10n_hr_zki and not o.l10n_hr_jir and print_with_payments">
                <p t-if="o.move_type in ('out_invoice', 'in_refund') and o.payment_reference" name="payment_communication" class="mt-4">
                    <span name="l10n_hr_payment_communication">
                        Please use the following communication for your payment :<br />
                        <span>Bank : </span>
                        <b><span t-field="o.partner_bank_id.bank_id.bic" /></b>-
                        <span t-field="o.partner_bank_id.bank_id.name" />
                        <br />
                        <span>Account number : </span>
                        <b><span t-field="o.partner_bank_id.acc_number" /></b>
                        <br />
                        <span>Payment reference : </span>
                        <b><span t-field="o.payment_reference" /></b>
                    </span>
                    <t t-if="o.partner_bank_id">
                        <br/>
                        on this account: <span t-field="o.partner_bank_id" class="fw-bold"/>
                    </t>
                </p>
            </t>
        </xpath>
        <xpath expr="//div[@name='payment_term']" position="replace">
            <t t-if="not o.l10n_hr_zki and not o.l10n_hr_jir and print_with_payments">
                <div t-field="o.invoice_payment_term_id.note" name="payment_term"/>
            </t>
        </xpath>
    </template>

    <template id="l10n_hr_report_fiskal.report_invoice_main" inherit_id="report_templates_account.report_invoice_main">
        <xpath expr="//div[@id='payment']" position="replace">
            <t t-if="not o.l10n_hr_zki and not o.l10n_hr_jir and print_with_payments">
                <div id="payment" class="row mt16 ml16 mr16">
                    <t t-call="report_templates_account.invoice_info_payment"/>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@id='qr_code']" position="replace">
            <t t-if="not o.l10n_hr_zki and not o.l10n_hr_jir and print_with_payments">
                <div id="qr_code" class="row mt16 ml16" style="page-break-inside:avoid;">
                    <t t-call="report_templates_account.qr_code"/>
                </div>
            </t>
        </xpath>
    </template>

</odoo>
