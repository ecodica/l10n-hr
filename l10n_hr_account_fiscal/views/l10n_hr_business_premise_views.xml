<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_business_premise_form_view" model="ir.ui.view">
        <field name="name">l10n_hr_business_premise_form_view</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_fiscal_premise_form"/>
        <field name="arch" type="xml">
            <field name="l10n_hr_state" position="before">
                <button string="TEST ECHO" type="object" name="button_l10n_hr_test_fiscal_echo"/>
            </field>
            <xpath expr="//field[@name='l10n_hr_fiscal_device_ids']//list/field[@name='l10n_hr_state']"
                   position="before">
                <field name="fiscalization_active" widget="boolean_toggle"/>
            </xpath>
            <button name="button_close_device" position="after">
                <button string="TEST ECHO" type="object" icon="fa-smile" class="btn-success"
                        invisible="not fiscalization_active" name="button_l10n_hr_test_fiscal_echo"/>
            </button>
            <notebook position="inside">
                <page string="Fiscal Logs">
                    <field name="l10n_hr_fiscal_log_ids" nolabel="1" colspan="4"/>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
