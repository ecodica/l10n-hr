<odoo>
  <data>

    <record id="open_view_address_type" model="ir.actions.act_window">
      <field name="name">Address Types</field>
      <field name="res_model">hr.address.type</field>
      <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_view_address_type"
              action="open_view_address_type"
              parent="hr_submenu_view_employees"
              groups="base.group_no_one"
              sequence="3"/>

      <record id="address_type_permanent" model="hr.address.type">
            <field name="name">Permanent Residence</field>
      </record>

      <record id="address_type_temporary" model="hr.address.type">
            <field name="name">Temporary Residence</field>
      </record>
  </data>
</odoo>