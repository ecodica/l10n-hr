<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_view_category_type_form" model="ir.ui.view">
        <field name="name">hr.category.type.form</field>
        <field name="model">hr.category.type</field>
        <field name="arch" type="xml">
            <form string="Category type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="employee_ids">
                            <list>
                                <field name="name"/>
                                <field name="work_email"/>
                                <field name="job_id"/>
                                <field name="department_id"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_view_category_type_tree" model="ir.ui.view">
        <field name="name">hr.category.type.tree</field>
        <field name="model">hr.category.type</field>
        <field name="arch" type="xml">
            <list string="Category type">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="hr_config_category_type_action" model="ir.actions.act_window">
        <field name="name">Category types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.category.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hr_menu_category_type"
              name="Category type"
              parent="hr_submenu_view_employees"
              sequence="100"
              action="hr_config_category_type_action"/>

</odoo>
