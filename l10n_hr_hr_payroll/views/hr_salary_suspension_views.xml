<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- hr.salary.suspension -->
        <record id="hr_salary_suspension_form_view" model="ir.ui.view">
            <field name="name">hr.salary.suspension.form</field>
            <field name="model">hr.salary.suspension</field>
            <field name="arch" type="xml">
                <form string="Obustava plaće">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="suspension_type"/>
                                <field name="max_ratio" required="suspension_type != 'membership'" invisible="suspension_type == 'membership'"/>
                                <field name="amount" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="start_amount" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="paid_amount"/>
                                <field name="end_amount"  invisible="suspension_type == 'membership'"/>
                                <field name="currency_id" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="i3_active" />
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="start_date"/>
                                <field name="due_date" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="number_of_annuities_paid"/>
                                <field name="ref"/>
                                <field name="model"/>
                            </group>
                        </group>
                        <group string="Postavke za članarinu" invisible="suspension_type != 'membership'">
                            <group>
                                <field name="membership_base" required="suspension_type == 'membership'"/>
                                <field name="membership_base_pct" required="suspension_type == 'membership'"/>
                            </group>
                        </group>
                        <separator string="Raspodjela po računima"/>
                        <group>
                            <field name="even_split"/>
                        </group>
                        <field name="bank_account_distribution_ids" context="{'syndicate': (suspension_type == 'membership')}">
                            <list string="Bank account distribution" editable="bottom">
                                <field name="bank_account_id" domain="[('partner_id.is_syndicate', '=', context.get('syndicate'))]"/>
                                <field name="partner_id"/>
                                <field name="share" sum="share_sum"/>
                            </list>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- hr.salary.suspension -->
        <record id="hr_payslip_employee_salary_suspension_form_view" model="ir.ui.view">
            <field name="name">hr.payslip.employee.salary.suspension.form</field>
            <field name="model">hr.payslip.employee.salary.suspension</field>
            <field name="arch" type="xml">
                <form string="Salary suspension">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="suspension_type"/>
                                <field name="max_ratio" required="suspension_type != 'membership'" invisible="suspension_type == 'membership'"/>
                                <field name="amount" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="start_amount" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="paid_amount"/>
                                <field name="end_amount"  invisible="suspension_type == 'membership'"/>
                                <field name="currency_id" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="i3_active" />
                                <field name="paid_this_month"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="start_date"/>
                                <field name="due_date" invisible="suspension_type in ('distraint','membership')"/>
                                <field name="number_of_annuities_paid"/>
                                <field name="ref"/>
                                <field name="model"/>
                            </group>
                        </group>
                        <group string="Membership settings" invisible="suspension_type != 'membership'">
                            <group>
                                <field name="membership_base" required="suspension_type == 'membership'"/>
                                <field name="membership_base_pct" required="suspension_type == 'membership'"/>
                            </group>
                        </group>
                        <group>
                            <field name="even_split"/>
                            <field name="bank_account_distribution_ids" context="{'syndicate': (suspension_type == 'membership')}">
                                <list string="Bank account distribution" editable="bottom">
                                    <field name="bank_account_id" domain="[('partner_id.is_syndicate', '=', context.get('syndicate'))]"/>
                                    <field name="partner_id"/>
                                    <field name="share" sum="share_sum"/>
                                </list>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_salary_suspension_search_view" model="ir.ui.view">
			<field name="name">hr.salary.suspension.search.view</field>
			<field name="model">hr.salary.suspension</field>
			<field name="arch" type="xml">
				<search>
					<field name="name"/>
					<field name="employee_id"/>
					<field name="suspension_type"/>
					<group expand="1" string="Group By">
						<filter string="Employee" name='group_employee' context="{'group_by':'employee_id'}"/>
						<filter string="Type" name='group_suspension_type' context="{'group_by':'suspension_type'}"/>
						<filter string="Active" name='group_i3_active' context="{'group_by':'i3_active'}"/>
					</group>
				</search>
			</field>
		</record>

        <record id="hr_salary_suspension_tree_view" model="ir.ui.view">
            <field name="name">hr.salary.suspension.tree</field>
            <field name="model">hr.salary.suspension</field>
            <field name="arch" type="xml">
                <list
                    decoration-danger="max_ratio == '1/1'"
                    decoration-info="max_ratio == '1/2'"
                    decoration-success="max_ratio == '1/3'"
                    decoration-muted="i3_active == False">
                    <field name="employee_id"/>
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="start_date"/>
                    <field name="amount"/>
                    <field name="currency_id"/>
                    <field name="suspension_type"/>
                    <field name="max_ratio"/>
                    <field name="membership_base"/>
                    <field name="membership_base_pct"/>
                    <field name="i3_active" />
                </list>
            </field>
        </record>

        <record id="hr_salary_suspension_payment_search_view" model="ir.ui.view">
			<field name="name">hr.salary.suspension.payment.search.view</field>
			<field name="model">hr.salary.suspension.payment</field>
			<field name="arch" type="xml">
				<search>
					<field name="suspension_id"/>
					<field name="payslip_id"/>
					<group expand="1" string="Group By">
						<filter string="Suspension" name='group_suspension' context="{'group_by':'suspension_id'}"/>
						<filter string="Payslip" name='group_payslip' context="{'group_by':'payslip_id'}"/>
					</group>
				</search>
			</field>
		</record>

        <record id="hr_salary_suspension_payment_tree_view" model="ir.ui.view">
            <field name="name">hr.salary.suspension.payment.tree</field>
            <field name="model">hr.salary.suspension.payment</field>
            <field name="arch" type="xml">
                <list>
					<field name="suspension_id"/>
					<field name="payslip_id"/>
					<field name="amount"/>
                </list>
            </field>
        </record>

        <record id="hr_salary_suspension_payment_form_view" model="ir.ui.view">
            <field name="name">hr.salary.suspension.payment.form</field>
            <field name="model">hr.salary.suspension.payment</field>
            <field name="arch" type="xml">
                <form>
					<field name="suspension_id"/>
					<field name="payslip_id"/>
					<field name="amount"/>
                </form>
            </field>
        </record>

        <record id="action_hr_salary_suspensions" model="ir.actions.act_window">
			<field name="name">Obustave plaće</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">hr.salary.suspension</field>
			<field name="view_mode">list,form</field>
			<field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
		</record>

		<record id="action_hr_salary_suspension_payments" model="ir.actions.act_window">
			<field name="name">Isplate obustava</field>
			<field name="type">ir.actions.act_window</field>
			<field name="res_model">hr.salary.suspension.payment</field>
			<field name="view_mode">list</field>
			<field name="context">{'create': 0, 'edit': 0, 'delete': 0}</field>
		</record>
    </data>
</odoo>
