<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>
    <record id="view_additional_income_report_wizard" model="ir.ui.view">
      <field name="name">additional.income.report.wizard.view</field>
      <field name="model">additional.income.report.wizard</field>
      <field name="arch" type="xml">
        <form string="Ispis potvrde o drugom dohotku">
          <group>
            <group>
              <field name="year_id"/>
              <field name="print_date"/>
            </group>
          </group>
          <field name="employee_line_ids">
            <list string="Zaposlenici" editable="top" create="false" delete="false">
              <field name="emp_id" column_invisible="1"/>
              <field name="employee_id"/>
              <field name="print_report"/>
            </list>
          </field>
          <footer>
            <button name="print_report" string="Ispis" type="object" class="oe_highlight"/>
            or
            <button special="cancel" string="Odustani" type="object" class="oe_link"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_additional_income_report_wizard" model="ir.actions.act_window">
      <field name="name">Ispis potvrde o drugom dohotku</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">additional.income.report.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="view_additional_income_report_wizard"/>
      <field name="target">new</field>
    </record>

  </data>
</odoo>
