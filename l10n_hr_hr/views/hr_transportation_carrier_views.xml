<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_view_transportation_carrier_form" model="ir.ui.view">
        <field name="name">hr.transportation.carrier.form</field>
        <field name="model">hr.transportation.carrier</field>
        <field name="arch" type="xml">
            <form string="Carrier">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="oib"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_view_transportation_carrier_tree" model="ir.ui.view">
        <field name="name">hr.transportation.carrier.tree</field>
        <field name="model">hr.transportation.carrier</field>
        <field name="arch" type="xml">
            <list string="Carrier">
                <field name="code"/>
                <field name="name"/>
                <field name="oib"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hr_view_transportation_carrier_search" model="ir.ui.view">
        <field name="name">hr.transportation.carrier.search</field>
        <field name="model">hr.transportation.carrier</field>
        <field name="arch" type="xml">
            <search string="Carrier">
                <field name="code" string="Carrier" filter_domain="['|','|',('code','ilike',self),('name','ilike',self),('description','ilike',self),('oib','ilike',self)]"/>
                <field name="name"/>
                <field name="oib"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="hr_config_transportation_carrier_action" model="ir.actions.act_window">
        <field name="name">Carrier</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.transportation.carrier</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_view_transportation_carrier_search"/>
    </record>

    <menuitem id="hr_menu_transportation_carrier"
              name="Carrier"
              parent="hr_submenu_view_employees"
              sequence="80"
              action="hr_config_transportation_carrier_action"/>
</odoo>
