<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="choose_parameters_duplicate_contract_wizard" model="ir.ui.view">
      <field name="name">choose.parameters.duplicate.contract.wizard</field>
      <field name="model">duplicate.contract.wizard</field>
      <field name="arch" type="xml">
        <form string="Dupliciraj parametre plaće">
          <group>
            <field name="duplicate_parameters"/>
          </group>
          <footer>
            <button string="Dupliciraj" name="duplicate_contract" type="object" class="oe_highlight"/>
            or
            <button string="Odustani" special="cancel" class="oe_link"/>
          </footer>
        </form>
      </field>
    </record>

    <record id="action_duplicate_contract" model="ir.actions.act_window">
      <field name="name">Duplicate salary parameters</field>
      <field name="res_model">duplicate.contract.wizard</field>
      <field name="view_mode">list,form</field>
      <field name="view_id" ref="choose_parameters_duplicate_contract_wizard"/>
      <field name="target">new</field>
    </record>
  </data>
</odoo>