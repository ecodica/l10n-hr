<odoo>
  <data>
    <record id="view_company_form_inherit" model="ir.ui.view">
      <field name="name">res.company.form.inherit</field>
      <field name="model">res.company</field>
      <field name="inherit_id" ref="base.view_company_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='company_registry']" position="after">
          <field name="hzmo_registry_number"/>
          <field name="hzzo_commitment_number"/>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/group/group[1]/div[1]//field[@name='street']" position="attributes">
            <attribute name="required">True</attribute>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/group/group[1]/div[1]//field[@name='zip']" position="attributes">
            <attribute name="required">True</attribute>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/group/group[1]/div[1]//field[@name='state_id']" position="replace">
        </xpath>
        <!-- replace city with city_id -->
        <xpath expr="/form/sheet/notebook/page/group/group[1]/div[1]//field[@name='city']" position="replace">
          <field name="city_id" placeholder="City" class="o_address_city" options='{"no_open": True, "no_create": True, "no_create_edit": True}' required = "1"/>
        </xpath>
        <xpath expr="/form/sheet/notebook/page/group/group[1]/div[1]//field[@name='country_id']" position="replace">
          <field name="country_id" placeholder="Country" class="o_address_country" required="True" options='{"no_open": True, "no_create": True, "no_create_edit": True}'/>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
