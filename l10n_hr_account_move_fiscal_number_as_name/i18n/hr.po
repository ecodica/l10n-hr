#. module: l10n_hr_account_move_fiscal_number_as_name
#: model:ir.model.fields,help:l10n_hr_account_move_fiscal_number_as_name.field_res_company__l10n_hr_fiscal_number_as_move_name
msgid ""
"Documents that have a Fiscal Number set will use it as name on account move."
msgstr ""
"Dokumenti koji koriste fiskalni broj će taj broj koristiti kao naziv "
"dokumenta."

#. module: l10n_hr_account_move_fiscal_number_as_name
#. odoo-python
#: code:addons/l10n_hr_account_move_fiscal_number_as_name/models/account_move.py:0
msgid ""
"Move name (%(move_name)s) is different from the Fiscal Number "
"(%(fiscal_number)s)"
msgstr ""
"Naziv dokumenta (%(move_name)s) je različit od fiskalnog broja "
"(%(fiscal_number)s). Postavite oba broja na isti."

#. module: l10n_hr_account_move_fiscal_number_as_name
#: model:ir.model.fields,field_description:l10n_hr_account_move_fiscal_number_as_name.field_res_company__l10n_hr_fiscal_number_as_move_name
msgid "Use Fiscal Number As Move Name"
msgstr "Koristi fiskalni broj kao naziv dokumenta"
