<odoo>
  <data>
    <record id="view_partner_form_inherit" model="ir.ui.view">
      <field name="name">res.partner.form.inherit</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='parent_id']" position="after">
          <button name="create_company" type="object" class="btn-link" invisible="is_company == True or company_name == '' or company_name == False">
            <span class="fa fa-plus-square"/>
            Create company
          </button>
        </xpath>

        <xpath expr="//form" position="attributes">
            <attribute name="create">false</attribute>
            <attribute name="edit">false</attribute>
            <attribute name="delete">false</attribute>
        </xpath>
        <!-- make address fields required -->
        <xpath expr="/form/sheet/group/group[1]" position="replace">
          <field name="is_gov_entity" invisible="True"/>
          <group>
            <field name="state_id" invisible="1"/>
            <field name="city" invisible="1"/>
            <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True, "no_create_edit": True}'
                readonly="type=='contact' and parent_id != False"/>
            <field name="type" invisible ="1"/>
            <div invisible="parent_id == False or type != 'contact'" class="oe_edit_only"><b>Company Address:</b></div>
            <field name="street" placeholder="Street..." class="o_address_street"
                readonly="parent_id != False and type == 'contact'" required="True"/>
            <field name="street2" placeholder="Street 2..." class="o_address_street"
                readonly="parent_id != False and type == 'contact'" />
            <field name="city_id" placeholder="City" class="o_address_city"
                readonly="parent_id != False and type == 'contact'" required="True" options='{"no_open": True, "no_create": True, "no_create_edit": True}'/>
            <field name="zip" placeholder="ZIP" class="o_address_zip"
                readonly="parent_id != False and type == 'contact'" required="True"/>
            <field name="county_id" placeholder="County" class="o_address_country"
                readonly="parent_id != False and type == 'contact'"/>
                <!-- added separator to separate address block from other fields so it looks better on the form -->
                <separator name="address_separator"/>
           </group>
        </xpath>
        <xpath expr='/form/sheet/notebook/page[@name="sales_purchases"]//field[@name="ref"]' position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath> 
        <!-- remove Accounting Entries from Invoicing notebook page -->
        <!-- NOTE: an inner group is removed from outer group -->
        <xpath expr="/form/sheet/notebook//page[@name='accounting']/group//group[2]" position="replace">
        </xpath>
        <!-- adding new fields -->
        <!-- added before separator so it is separated from addres block -->
        <xpath expr="/form/sheet/group/group[1]/separator" position="after">
          <field name="vat_country_id" required="internal == False" options="{'no_create': True, 'no_open': True, 'no_edit': True, 'no_create_edit': True}"/>
          <field name="oib" required="internal == False" readonly="True"/>
          <field name="oib_extension" invisible="1"/>
          <field name="property_account_position_id" options="{'no_create': True, 'no_open': True}"/>
          <field name="vat" required="internal == False" readonly="True"/>
          <field name="vat_form"/>
        </xpath>
        <xpath expr='/form/sheet/div[2]' position="inside">
          <group>
              <field name="customer"/>
              <field name="internal" readonly='1'/>
              <field name="not_validated" readonly="True" invisible="True"/>
            </group>
        </xpath>
        <xpath expr='/form/sheet/notebook' position="before">
          <group string="Accounting Entries" name="accounting_entries" groups="account.group_account_user">
            <group>
              <!-- MIGRACIJA  domena zakomentirana jer traži field account_level koji je u modulu hr_account => migrirati modul ? -->
              <!-- domain="[('deprecated', '=', False), ('account_level', 'in', ('analytic', 'subanalytic')), ('user_type_id.type', '=', 'receivable')]" -->
              <field name="property_account_receivable_id"
                options="{'no_open': True, 'no_create': True}"
                required="customer == True"
              />
              <!-- MIGRACIJA  domena zakomentirana jer traži field account_level koji je u modulu hr_account => migrirati modul ? -->
              <!-- domain="[('deprecated', '=', False), ('account_level', 'in', ('analytic', 'subanalytic')), ('user_type_id.type', '=', 'receivable')]" -->
              <!-- Rquired je zakomentirani jer na v17 ne postoji supplier polje kao na v12 - migrirati polje?  -->
              <!-- required="supplier == True" -->
              <field name="property_account_payable_id"
                options="{'no_open': True, 'no_create': True}"
              />
            </group>
            <group>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>
        </xpath>
        <!-- fiscal info is already shown on header so we hide fiscal info3 group in sale_purchase tab
        just replacing group didn't work because there is some interference with other modules
        that is why position_id field has been replaced and group set as invisible as a workaround -->
        <xpath expr="//group[@name='fiscal_information']/field[@name='property_account_position_id']" position="replace"/>
        <xpath expr="//group[@name='fiscal_information']" position="attributes">
          <attribute name="invisible">1</attribute>
        </xpath>
        <!-- end of fiscal info comment -->
        <xpath expr="/form/sheet/notebook/page[@name='sales_purchases']" position="after">
          <page string="Entry Details" name="entry_details">
            <group name="entry_details_container">
                <group name="entry_details_dates">
                    <field name="create_date"/>
                    <field name="write_date"/>
                </group>
                <group name="entry_details_users">
                  <field name="create_uid"/>
                  <field name="write_uid"/>
                </group>
            </group>
          </page>
        </xpath>
        <!-- adding oib, vat, vat_country_id to child's context  // used for autofilling billing information-->
        
       <!-- replaces the child_ids addreses - added by clicking on "Add" button under tab "Contacts and Adresses" -->

       <!-- parent_id and type fields needed in attrs in base_address_city module which overwrites
        _fields_view_get() of partner. It would be better to put those fields there but the web client
        dosen't support when a field is displayed several times in the same view. -->
        <xpath expr="/form/sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form" position="replace">
          <form string="Contact / Address">
            <sheet>
                <field name="type" required="1" widget="radio" options="{'horizontal': true}"/>
                <field name="parent_id" invisible="1"/>
                <hr/>
                <group>
                    <group invisible="type=='contact'">
                        <label for="street" string="Address"/>
                        <div>
                            <div class="o_address_format" name="div_address">
                                <field name="street" placeholder="Street..." class="o_address_street" required="True"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city_id" placeholder="City" class="o_address_city" required="True" options='{"no_open": True, "no_create": True, "no_quick_create": True, "no_create_edi":True}'/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip" required="True"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </div>
                    </group>
                    <group>
                        <field name="name" string="Contact Name" required="1"/>
                        <field name="title" placeholder="e.g. Mr."
                            invisible="type != 'contact'"/>
                        <field name="function" placeholder="e.g. Sales Director"
                            invisible="type != 'contact'"/>
                        <field name="email"/>
                        <field name="phone" widget="phone"/>
                        <field name="mobile" widget="phone"/>
                        <field name="comment" placeholder="internal note..."/>
                    </group>
                </group>
                <field name="lang" invisible="True"/>
                <field name="user_id" invisible="True"/>
                <field name="vat_country_id" invisible="True"/>
            </sheet>
          </form>
        </xpath> 
        <!-- oib field is autofilled from parent's oib -->
        <xpath expr="/form/sheet/notebook/page[@name='contact_addresses']/field[@name='child_ids']/form/sheet/group/group[1]/div[1]" position="after">
          <field name="oib" invisible="True"/>
        </xpath> 
      </field>
    </record>

    <!-- CUSTOMER VALIDATION -->

    <record id="res_partner_kanban_view_inherit" model="ir.ui.view">
        <field name="name">res.partner.kanban.inherit.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
          <xpath expr="//kanban" position="attributes">
              <attribute name="create">false</attribute>
              <attribute name="edit">false</attribute>
              <attribute name="delete">false</attribute>
          </xpath>
        </field>
    </record>

    <!-- res.partner Form - CREATE CUSTOMER-->
    <record id="view_partner_form_group_create_customer" model="ir.ui.view">
      <field name="name">res.partner.form.group.create.customer</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="base.view_partner_form"/>
      <field name="arch" type="xml">
        <xpath expr="//form" position="attributes">
            <attribute name="create">true</attribute>
            <attribute name="edit">true</attribute>
            <attribute name="delete">true</attribute>
            
            <!-- ZAKOMENTIRANO <attribute name="create" groups="l10n_hr_payroll_base.group_create_customer">true</attribute>
            <attribute name="edit" groups="l10n_hr_payroll_base.group_create_customer">true</attribute>
            <attribute name="delete" groups="l10n_hr_payroll_base.group_create_customer">true</attribute> -->
        </xpath>
      </field>
    </record>

    <!-- res.partner Kanban - CREATE CUSTOMER-->
    <record id="res_partner_kanban_view_group_create_customer" model="ir.ui.view">
      <field name="name">res.partner.kanban.group.create.customer</field>
      <field name="model">res.partner</field>
      <field name="inherit_id" ref="l10n_hr_payroll_base.res_partner_kanban_view_inherit"/>
      <field name="arch" type="xml">
        <xpath expr="//kanban" position="attributes">
            <attribute name="create">true</attribute>
            <attribute name="edit">true</attribute>
            <attribute name="delete">true</attribute>
            <!-- <attribute name="create" groups="l10n_hr_payroll_base.group_create_customer">true</attribute>
            <attribute name="edit" groups="l10n_hr_payroll_base.group_create_customer">true</attribute>
            <attribute name="delete" groups="l10n_hr_payroll_base.group_create_customer">true</attribute> -->
        </xpath>
      </field>
    </record>

