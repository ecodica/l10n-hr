<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_account_journal_l10n_hr_form" model="ir.ui.view">
        <field name="name">view_account_journal_l10n_hr_form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Croatia Specific" name="croatia_page" invisible ="type != 'sale' and company_id.country_code != 'HR'">
                    <group>
                        <field name="l10n_hr_default_fiscal_payment_method"/>
                        <field name="l10n_hr_business_premise_id"/>
                        <field name="l10n_hr_fiscal_device_ids"
                               domain="[('l10n_hr_business_premise_id','=', l10n_hr_business_premise_id)]"
                               groups="account.group_account_manager"
                               invisible ="l10n_hr_business_premise_id == 'False'"
                               widget="many2many_tags" readonly="1" />
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
