<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <group name="sale" position="inside">
                <field name="l10n_hr_sale_journal_id"/>
            </group>
            <group name="purchase" position="inside">
                <field name="l10n_hr_purchase_journal_id"/>
            </group>
        </field>
    </record>

    <record id="view_partner_form_inherit_account" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.account</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form" />
        <field name="arch" type="xml">
            <group id="invoice_send_settings" position="inside">
                     <field name="l10n_hr_caba" invisible="country_code != 'HR'"/>
            </group>
        </field>
    </record>

</odoo>
