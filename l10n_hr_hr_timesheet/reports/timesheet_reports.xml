<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="info3_timesheet_report" model="ir.actions.report">
            <field name="name">Detailed timesheet report</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_hr_hr_timesheet.report_info3_timesheet</field>
            <field name="report_file">l10n_hr_hr_timesheet.report_info3_timesheet</field>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Detailed timesheet report'</field>
            <field name="paperformat_id" ref="l10n_hr_hr_timesheet.info3_landscape_paperformat_low_margin"/>
        </record>

        <record id="info3_timesheet_report_sum" model="ir.actions.report">
            <field name="name">Summarized timesheet report</field>
            <field name="model">hr.employee</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_hr_hr_timesheet.report_info3_timesheet_sum</field>
            <field name="report_file">l10n_hr_hr_timesheet.report_info3_timesheet_sum</field>
            <field name="binding_model_id" ref="hr.model_hr_employee"/>
            <field name="binding_type">report</field>
            <field name="print_report_name">'Summarized timesheet report'</field>
            <field name="paperformat_id" ref="l10n_hr_hr_timesheet.info3_landscape_paperformat_low_margin"/>
        </record>

        
        <report
            id="info3_timesheet_absence_report"
            model="timesheet.absence.wizard"
            string="Timesheet absence report"
            report_type="qweb-pdf"
            name="report_info3_timesheet_absence"
            file="report_info3_timesheet_absence"
            paperformat="hr_base.paperformat_a4_low_margin_low_header"
            print_report_name="(object._get_report_base_filename())"
        />

    </data>
</odoo>
