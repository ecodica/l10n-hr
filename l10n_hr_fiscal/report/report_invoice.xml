<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_invoice_document_hr_fiscalization_fields" inherit_id="account.report_invoice_document"
                  primary="True">
            <!--  wkhtmltopdf 0.12.6 prilagodbe -->
            <xpath expr="//div[@t-if='o.partner_id.vat']" position="replace">
                <div t-if="o.partner_id.vat" class="mt16">
                    OIB:
                    <t t-if="o.partner_id.country_id == o.company_id.country_id">
                        <span t-esc="o.partner_id.vat[2:]"/>
                    </t>
                    <t t-else="">
                        <span t-field="o.partner_id.vat"/>
                    </t>
                </div>
            </xpath>
            <xpath expr="//div[hasclass('mb-3')]" position="after">
                <div class="row">
                    <div class="col-12">
                        <span t-field="o.company_id.tax_note"/>
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@id='informations']" position="before">
                <div t-if="o.working_place_id" class="row"
                     name="row_working_place" style="font-size: 13px; margin: 0px;">
                    <div class="col-12">
                        <strong>Work place:</strong>
                        <span t-if="o.working_place_id.l10n_hr_name" t-field="o.working_place_id.l10n_hr_name"/>
                        <span t-if="o.working_place_id.l10n_hr_fiscal_code"
                              t-field="o.working_place_id.l10n_hr_fiscal_code"/>
                        <t t-if="o.working_place_id.l10n_hr_invoice_place">
                            <span t-field="o.working_place_id.l10n_hr_invoice_place"/>
                        </t>
                        <t t-else="">
                            <span t-if="o.company_id.street" t-field="o.company_id.street"/>
                            <span t-if="o.company_id.zip" t-field="o.company_id.zip"/>
                            <span t-if="o.company_id.city" t-field="o.company_id.city"/>
                        </t>
<!--                        <span t-if="o.working_place_id.street" t-field="o.working_place_id.street"/>-->
<!--                        <span t-if="o.working_place_id.number" t-field="o.working_place_id.number"/>-->
<!--                        <span t-if="o.working_place_id.number_extra" t-field="o.working_place_id.number_extra"/>-->
<!--                        <span t-if="o.working_place_id.post_code" t-field="o.working_place_id.post_code"/>-->
<!--                        <span t-if="o.working_place_id.city" t-field="o.working_place_id.city"/>-->
<!--                        <span t-if="o.working_place_id.spec" t-field="o.working_place_id.spec"/>-->
                    </div>
                </div>
            </xpath>

            <xpath expr="//div[@id='total']" position="attributes">
                <attribute name="class">row justify-content-between</attribute>
            </xpath>

            <!--  prostor za qr i fisk stuff -->
            <xpath expr="//div[@id='total']/div" position="attributes">
                <attribute name="t-attf-class">#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'}</attribute>
            </xpath>

            <xpath expr="//div[@id='total']/div" position="before">
                <t t-if="o.fisc_state == 'done'">
                    <div t-attf-class="#{'col-1' if report_type != 'html' else 'col-sm-2 col-md-1'}"
                         style="page-break-inside:avoid;margin-left:0rem;margin-right:2rem;"
                         id="fiscalization_qr_zki_jir">
                        <div class="pull-left"
                             style="width:2cm;height:2cm;border: 1px solid lightgray; border-radius: 5px; padding: 2px;">
                            <img height="auto" width="100%"

                                 t-attf-src="data:image;base64,{{o.fisc_qr_code}}"
                            />

                        </div>
                    </div>
                    <div t-attf-class="#{'col-3' if report_type != 'html' else 'col-sm-3 col-md-3'}"
                         style="page-break-inside:avoid;margin-left:0rem;margin-right:7rem;">
                        <div t-if="o.number_zki" style="white-space: nowrap;">
                            <small>
                                <strong>ZKI:</strong>
                                <span t-field="o.number_zki"/>
                            </small>
                        </div>
                        <div t-if="o.number_jir" style="white-space: nowrap;">
                            <small>
                                <strong>JIR:</strong>
                                <span t-field="o.number_jir"/>
                            </small>
                        </div>
                    </div>
                </t>
            </xpath>

            <xpath expr="//div[@name='invoice_date']" position="replace">
                <div class="col-auto col-3 mw-100 mb-2" t-if="o.invoice_date_time" name="invoice_date_time">
                    <strong>Invoice Date and Time:</strong>
                    <p class="m-0" t-field="o.invoice_date_time"/>
                </div>
            </xpath>

            <xpath expr="//div[@name='reference']" position="after">
                <div class="col" t-if="o.fisc_employee_id" name="fisc_employee_id">
                    <strong>Salesperson:</strong>
                    <p class="m-0" t-if='o.sudo().fisc_employee_id.fiscal_employee_name'
                       t-field="o.sudo().fisc_employee_id.fiscal_employee_name"/>
                    <p class="m-0" t-else='' t-field="o.fisc_employee_id"/>
                </div>
                <div class="col" t-if="not o.fisc_employee_id" name="fisc_user_id">
                    <strong>Salesperson:</strong>
                    <p class="m-0" t-if="o.fisc_user_id" t-field="o.fisc_user_id"/>
                    <p class="m-0" t-else="" t-field="o.create_uid"/>
                </div>

                <t t-set="invoice_payments" t-value="o.get_payment_journal(type='name')"></t>
                <div class="col" t-if="invoice_payments" name="invoice_payments">
                    <strong>Invoice Payments:</strong>
                    <p class="m-0" t-esc="invoice_payments"/>
                </div>
                <div class="col" t-if="not invoice_payments">
                    <strong>Payment type:</strong>
                    <p class="m-0">
                        <span t-field="o.company_id.default_payment_note"/>
                    </p>
                </div>

                <!-- refaktorirati kasnije, ovo je stavljeno u dogovoru s konzultantom (za basketu), -->
                <!-- jer nemamo razradjeno u 14ci-->
                <div class="col" t-if="o.company_id.city" name="place_of_issue">
                    <strong>Place of Issue:</strong>
<!--                    <t t-if="o.working_place_id and o.working_place_id.city">-->
<!--                        <p class="m-0" t-field="o.working_place_id.city"/>-->
<!--                    </t>-->
<!--                    <t t-else="">-->
                    <p class="m-0" t-field="o.company_id.city"/>
<!--                    </t>-->
                </div>

            </xpath>

        </template>

        <template id="report_invoice" inherit_id="account.report_invoice">
            <xpath expr='//t[@t-call="account.report_invoice_document"]' position="after">
                <t t-if="o._get_name_invoice_report() == 'fiscalization_hr.report_invoice_document_hr_fiscalization_fields'"
                   t-call="l10n_hr_fiscal.report_invoice_document_hr_fiscalization_fields" t-lang="lang"/>
            </xpath>
        </template>
<!--        <template id="report_invoice_with_payments" inherit_id="account.report_invoice_with_payments">-->
<!--            <xpath expr='//t[@t-call="account.report_invoice"]' position="after">-->
<!--                <t t-if="o._get_name_invoice_report() == 'fiscalization_hr.report_invoice_document_hr_fiscalization_fields'"-->
<!--                   t-call="l10n_hr_fiscal.report_invoice_document_hr_fiscalization_fields" t-lang="lang"/>-->
<!--            </xpath>-->
<!--        </template>-->


    </data>
</odoo>
