<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No journals or accounting configuration: managers may have no accounting role. -->
    <record id="fiscal_premise_list_view" model="ir.ui.view">
        <field name="name">l10n_hr.business.premise.fiscal.list</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="l10n_hr_name"/>
                <field name="l10n_hr_fiscal_code"/>
                <field name="l10n_hr_state"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <button name="action_new_fiscal_operation" type="object" string="Working Hours Fiscalization"/>
            </list>
        </field>
    </record>
    <record id="fiscal_premise_form_view" model="ir.ui.view">
        <field name="name">l10n_hr.business.premise.fiscal.form</field>
        <field name="model">l10n_hr.business.premise</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button name="action_new_fiscal_operation" type="object"
                            string="Working Hours Fiscalization" class="btn-primary"
                            groups="l10n_hr_account_fiscal.group_fiscal_manager"/>
                </header>
                <sheet>
                    <group>
                        <field name="l10n_hr_name"/>
                        <field name="l10n_hr_fiscal_code"/>
                        <field name="l10n_hr_state"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <button name="action_open_fiscal_operations" type="object" string="Fiscal Operations"/>
                    <notebook>
                        <page string="Regular Working Hours">
                            <field name="regular_working_hours_ids" readonly="1"/>
                        </page>
                        <page string="Exception Working Hours">
                            <field name="exception_working_hours_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_fiscal_premises" model="ir.actions.act_window">
        <field name="name">Business Premises</field>
        <field name="res_model">l10n_hr.business.premise</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('fiscal_premise_list_view')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('fiscal_premise_form_view')})]"/>
    </record>
    <!-- Fiscal managers need not have access to the Accounting application. -->
    <menuitem id="menu_fiscalization_root" name="Fiscalization" sequence="60"
              groups="l10n_hr_account_fiscal.group_fiscal_manager"/>
    <menuitem id="menu_fiscalization_premises" parent="menu_fiscalization_root"
              action="action_fiscal_premises" sequence="10"/>
    <menuitem id="menu_fiscalization_operations" parent="menu_fiscalization_root"
              action="action_l10n_hr_fiscal_operation" sequence="20"/>
    <menuitem id="menu_fiscalization_schedules" parent="menu_fiscalization_root"
              action="action_l10n_hr_working_hours_schedule" sequence="30"/>
    <menuitem id="menu_fiscalization_logs" parent="menu_fiscalization_root"
              action="action_l10n_hr_fiscal_log" sequence="40"/>
</odoo>
