		<field name="arch" type="xml">
			<list string="JOPPD ">
			<field name="name" />
			<field name="description" />
			</list>
		</field>
		</record>


		<!-- JOPPD XML attachment-->
		
		<record id="joppd_xml_attachment_form" model="ir.ui.view">
			<field name="model">ir.attachment</field>
			<field name="arch" type="xml">
				<form string="Privitci">
					<group>
						<label for="datas" string="XML datoteka"/>
						<div>
							<div>
								<!-- field datas needs to be readonly because it can't be downloaded in edit mode -->
								<field name="datas" widget="" filename="name" readonly="1"/>
								<field name="name" invisible="1"/>
							</div>
						</div>
					</group>
					<footer>
						<button string="Odustani" special="cancel" class="oe_link"/>
					</footer>
				</form>
			</field>
		</record>
    
