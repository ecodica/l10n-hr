<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="view_company_form_fiscalization_configuration" model="ir.ui.view">
        <field name="name">view.company.form.fiscalization.configuration</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']/group/group[2]" position="inside">
                <field name="tax_note"/>
                <field name="default_payment_note"/>
            </xpath>

            <xpath expr="//notebook/page" position="after">
                <page string="Fiscalization setup">
                    <field name="fisc_env" style="background-color: indianred; font-size:1.2em;"/>
                    <group name="general" string="General">
                        <field name="use_fiscalization"/>
                        <field name="fisc_paid_invoice"/>
                    </group>
                    <group name="setup" string="Setup">
                        <group>
                            <field name="fisc_use_logged_user"/>
                        </group>
                        <group groups="base.group_no_one">
                            <field name="server_address"/>
                            <field name="server_port"/>
                            <field name="service_name"/>
                            <button name="button_test_fiscalization_echo" string="ECHO test" type="object"
                                    class="btn-link"/>
                            <field name="echo_message" nolabel="1"/>
                        </group>
                    </group>
                    <group name="certificate_config" string="Certificate configuration">
                        <group>
                            <field name="certificate"/>
                            <field name="certificate_pass" password="True"/>
                            <field name="certificate_pem" invisible="1"/>
                            <field name="certificate_key" invisible="1"/>
                        </group>
                        <group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
