<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_l10n_hr_fiscal_move_form" model="ir.ui.view">
        <field name="name">view_l10n_hr_fiscal_move_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_hr_account_base.view_l10n_hr_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='croatia']//field[@name='l10n_hr_payment_method']" position="after">
                <field name="l10n_hr_paragon_br" readonly="state != 'draft'"/>
                <field name="l10n_hr_fiscal_user_id" readonly="state != 'draft'"/>
                <field name="l10n_hr_late_delivery" readonly="l10n_hr_jir"/>
                <button string="Fiscalize" type="object" name="button_fiscalize" class="btn-primary"
                        invisible="not l10n_hr_fiscal_number or l10n_hr_jir"/>
                <button string="Fiscal Check" type="object" name="button_fiscalize_check"
                        invisible="not l10n_hr_jir"/>
                <button string="Fiscal Change Data" type="object" name="button_fiscalize_change"
                        invisible="not l10n_hr_jir"/>
            </xpath>
            <group name="l10n_hr_base_fiscal" position="after">
                <group name="l10n_hr_fiscal_full" invisible="not l10n_hr_zki">
                    <field name="l10n_hr_zki"/>
                    <field name="l10n_hr_jir"/>
                    <field name="l10n_hr_fiscal_qr" widget="image"
                           ooptions="{'size': [90, 90]}"/>
                </group>
                <field name="l10n_hr_fiscal_log_ids"/>
            </group>
        </field>
    </record>

    <record id="view_account_invoice_filter_l10n_hr_account_fiscal" model="ir.ui.view">
        <field name="name">view_account_invoice_filter_l10n_hr_account_fiscal</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <filter name="to_check" position="before">
                <filter name="fiscalized" string="Fiscalized"
                        domain="[('l10n_hr_zki', '!=', False), ('l10n_hr_jir', '!=', False)]"/>
                <filter name="not_fiscalized" string="Not Fiscalized"
                        domain="[('l10n_hr_zki', '!=', False), ('l10n_hr_jir', '=', False)]"/>
                <separator/>
            </filter>
        </field>
    </record>

</odoo>
