<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_view_contract_document_type_form" model="ir.ui.view">
        <field name="name">hr.contract.document.type.form</field>
        <field name="model">hr.contract.document.type</field>
        <field name="arch" type="xml">
            <form string="Contract document type">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_view_contract_document_type_tree" model="ir.ui.view">
        <field name="name">hr.contract.document.type.tree</field>
        <field name="model">hr.contract.document.type</field>
        <field name="arch" type="xml">
            <list string="Contract document type">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hr_view_contract_document_type_search" model="ir.ui.view">
        <field name="name">hr.contract.document.type.search</field>
        <field name="model">hr.contract.document.type</field>
        <field name="arch" type="xml">
            <search string="Contract document types">
                <field name="code" string="Contract document type" filter_domain="['|','|',('code','ilike',self),('name','ilike',self),('description','ilike',self)]"/>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="hr_config_contract_document_type_action" model="ir.actions.act_window">
        <field name="name">Contract document types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.contract.document.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_view_contract_document_type_search"/>
    </record>

    <menuitem id="hr_menu_contract_document_type"
              name="Contract document type"
              parent="hr_submenu_view_contracts"
              groups="hr.group_hr_manager,hr_contract.group_hr_contract_manager"
              sequence="2"
              action="hr_config_contract_document_type_action"/>

</odoo>
