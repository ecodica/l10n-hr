<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_tax_form_l10n_hr_fiscal" model="ir.ui.view">
        <field name="name">view_account_tax_form_l10n_hr_fiscal</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_tax_use']" position="after">
                <field name="l10n_hr_tax_type" invisible="country_code !='HR'"/>
            </xpath>
        </field>
    </record>
</odoo>