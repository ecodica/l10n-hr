<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_view_disability_type_form" model="ir.ui.view">
        <field name="name">hr.disability.type.form</field>
        <field name="model">hr.disability.type</field>
        <field name="arch" type="xml">
            <form string="Disability type">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_view_disability_type_tree" model="ir.ui.view">
        <field name="name">hr.disability.type.tree</field>
        <field name="model">hr.disability.type</field>
        <field name="arch" type="xml">
            <list string="Disability type">
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="hr_view_disability_type_search" model="ir.ui.view">
        <field name="name">hr.disability.type.search</field>
        <field name="model">hr.disability.type</field>
        <field name="arch" type="xml">
            <search string="Disability types">
                <field name="code" string="Disability type" filter_domain="['|','|',('code','ilike',self),('name','ilike',self),('description','ilike',self)]"/>
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

    <record id="hr_config_disability_type_action" model="ir.actions.act_window">
        <field name="name">Disability types</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.disability.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_view_disability_type_search"/>
    </record>

    <menuitem id="hr_menu_disability_type"
              name="Disability type"
              parent="hr_submenu_view_employees"
              sequence="50"
              action="hr_config_disability_type_action"/>

</odoo>
