<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_info3_timesheet">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.basic_layout">
        <t t-foreach="report_lines" t-as="line">
                <style>
                    .table thead tr td {
                        padding: 1px;
                        width: 3%;
                        border: 0.5px solid black;
                        vertical-align: middle;
                        height: 15px;
                        background-color:lightgrey;
                    }
                    .table tbody tr td {
                        padding: 1px;
                        width: 3%;
                        border: 0.5px solid black;
                        vertical-align: middle;
                        height: 15px;
                    }
                    .title-left-column {
                        width: 23%;
                        padding: 1px;
                    }
                    .title-right-column {
                        width: 23%;
                        padding: 1px 1px 1px 5px;
                    }
                    .title-middle-column {
                        border-bottom: 1px solid black;
                        width: 27%;
                        padding: 1px;
                    }
                    .legend-table tr td:nth-child(even) {
                        width: 8.5%;
                        padding: 1px 2px 0px 3px;
                        text-align: left;
                    }
                    .legend-table tr td:nth-child(odd) {
                        width: 1.5%;
                        text-align:right;
                    }
                </style>
                <!-- whole doc container -->
                <div style="font-size: 7pt; font-family:Helvetica;">
                    <div class="text-center" style="font-size: 10pt;">
                        <t t-if="line['employee_by_contract'] == True">
                            <strong>Evidencija o radnom vremenu radnika</strong>
                        </t>
                        <t t-else="">
                            <strong>Evidencija o trajanju rada određenih kategorija fizičkih osoba</strong>
                        </t>
                    </div>
                    <t t-if="line['employee_by_contract'] == True">
                        <div class="text-center" style="font-size: 9pt;">
                            <strong>Podaci o radnom vremenu radnika</strong> (obveza iz čl. 13. Pravilnika o sadržaju i načinu vođenja evidencije o radnicima zaposlenim kod poslodavca - Nar. nov. br. 55/24)
                        </div> 
                    </t>
                    <t t-else="">
                        <div class="text-center" style="font-size: 9pt;">
                            <strong>Podaci o trajanju rada</strong> (obveza iz čl. 22. Pravilnika o sadržaju i načinu vođenja evidencije o radnicima zaposlenim kod poslodavca - Nar. nov. br. 55/24)
                        </div> 
                    </t>
                    <div style="width: 100%; margin-top: 10px;">
                        <table id="title_table" class="table-borderless" style="margin-left: 15%; width: 55%; float: left;">
                            <tr>
                                <td class="title-left-column"><strong>IME I PREZIME:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black">
                                    <span t-esc="line['employee_name']"/></td>
                                <td class="title-right-column" style="padding-left:15px;"><strong>POSLODAVAC:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black"><span t-esc="line['company_name']"/></td>
                            </tr>
                            <tr>
                                <tr>
                                <td class="title-left-column"><strong>EVIDENCIJA ZA MJESEC:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black">
                                    <span t-esc="line['month']"/></td>
                                <td class="title-right-column" style="padding-left:15px; "><strong>ORG. JEDINICA:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black"><span t-esc="line['department_name']"/></td>
                            </tr>
                            </tr>
                            <tr>
                                <td class="title-left-column"><strong>EVIDENCIJA ZA GODINU:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black"><span t-esc="line['year']"/></td>
                                <td class="title-right-column" style="padding-left:15px;"><strong>RADNO MJESTO:</strong></td>
                                <td class="title-middle-column text-center" style="border-bottom: 1px solid black"><span t-esc="line['job_title']"/></td>
                            </tr>
                        </table>
                        <table style="width: 18%; margin-right:12%; float:right;" class="table-borderless">
                            <tr></tr>
                            <tr> 
                                <td style="padding-left:15px;">
                                    <strong><span>MJESEČNI FOND SATI: </span></strong>
                                </td>
                                <td style="text-align: center; border-bottom: 1px solid black; width:40px;">
                                    <span t-esc="line['number_of_hours']"/>
                                </td><td></td>
                            </tr>
                            <tr> 
                                <td style="padding-left:15px;">
                                    <strong><span>BROJ RADNIH DANA: </span></strong>
                                </td>
                                <td style="text-align: center; border-bottom: 1px solid black; width:40px;">
                                    <span t-esc="line['number_of_days']"/>
                                </td><td></td>
                            </tr>
                        </table>
                    </div>
                    <div id="legend" style="margin-top: 70px;">
                        <table class="legend-table table-borderless">
                            <tr>
                                <td>1 - </td><td>Dnevno radno vrijeme u satima (RR)</td>
                                <td>4 - </td><td>Praznik/Blagdan (BL)</td>
                                <td>7 - </td><td>Dnevni odmor (DO)</td>
                                <td>10 - </td><td>Smjenski rad (SR)</td>
                                <td>13 - </td><td>Terenski rad (TR)</td>
                                <td>16 - </td><td>Bolovanje (BO)</td>
                                <td>19 - </td><td>Druga roditeljska prava (RP)</td>
                                <td>22 - </td><td>Nenazočnost na zahtjev radnika (NR)</td>
                                <td>25 - </td><td>Isključenje s rada (lockout) (ISR)</td>
                                <td>28 - </td><td>Vrijeme pripravnosti (VP)</td>
                            </tr>
                            <tr>
                                <td>2 - </td><td>Noćni rad (NO)</td>
                                <td>5 - </td><td>Neradni dan - nedjelja (NDN)</td>
                                <td>8 - </td><td>Tjedni odmor (TO)</td>
                                <td>11 - </td><td>Izaslani rad (IR)</td>
                                <td>14 - </td><td>Terenski rad inozemstvo (TRI)</td>
                                <td>17 - </td><td>Bolovanje na teret fonda (BOF)</td>
                                <td>20 - </td><td>Plaćeni dopust (PD)</td>
                                <td>23 - </td><td>Nenazočnost krivnjom radnika (NKR)</td>
                                <td>26 - </td><td>Sati zastoja krivnjom poslodavca (SZP)</td>
                                <td>29 - </td><td>Roditeljski dopust (RDP)</td>
                            </tr>
                            <tr>
                                <td>3 - </td><td>Prekovremeni rad (PRR)</td>
                                <td>6 - </td><td>Neradni dan - praznik (NDP)</td>
                                <td>9 - </td><td>Godišnji odmor (GO)</td>
                                <td>12 - </td><td>Preraspodjeljeno radno vrijeme (PR)</td>
                                <td>15 - </td><td>Dvokratni rad (DR)</td>
                                <td>18 - </td><td>Rodiljni dopust (RD)</td>
                                <td>21 - </td><td>Neplaćeni dopust (ND)</td>
                                <td>24 - </td><td>Štrajk (STR)</td>
                                <td>27 - </td><td>Vrijeme zastoja (VZ)</td>
                                <td>30 - </td><td>Očinski dopust i dopust drugog posvojitelja (OD)</td>
                            </tr>
                            <tr>
                                <td>31 - </td><td>Odsutnost s rada (ODSR)</td>
                                <td>32 - </td><td>Neplaćeni dopust za pružanje osobne skrbi (NDSK)</td>
                                <td>33 - </td><td>Neplaćeni dopust kandidata (NDKA)</td>
                                <td>34 - </td><td>Nenazočnost zbog vojne obveze ili služenja u ugovornoj pričuvi (NHVO)</td>
                            </tr>
                        </table>
                    </div>
                    <div id="timesheet" style="margin-top: 10px;">
                        <table class="table text-center">
                            <thead>
                                <tr>
                                    <td style="width:5%;" rowspan="2">Datum</td><td rowspan="2">Početak rada</td><td rowspan="2">Kraj rada</td><td t-att-colspan="3">1</td>
                                    <td>BL</td><td>NDN</td><td>NDP</td><td>DO</td><td>TO</td><td>GO</td><td>SR</td>
                                    <td>IR</td><td>PR</td><td>TR</td><td>TRI</td><td>DR</td><td>BO</td><td>BOF</td>
                                    <td>RD</td><td>OD</td><td>RDP</td><td>RP</td><td>PD</td><td>ND</td><td>ODSR</td><td>NDSK</td><td>NDKA</td><td>NHVO</td><td>NR</td><td>NKR</td>
                                    <td>ŠTR</td><td>ISR</td><td>SZP</td><td>VZ</td><td>VP</td>
                                </tr>
                                <tr>
                                    <td>Ukupno</td>
                                    <td>2</td><td>3</td><td>4</td><td>5</td><td>6</td><td>7</td><td>8</td>
                                    <td>9</td><td>10</td><td>11</td><td>12</td><td>13</td><td>14</td><td>15</td>
                                    <td>16</td><td>17</td><td>18</td><td>30</td><td>29</td><td>19</td><td>20</td><td>21</td><td>31</td><td>32</td><td>33</td><td>34</td>
                                    <td>22</td><td>23</td><td>24</td><td>25</td><td>26</td><td>27</td><td>28</td>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="line['data']" t-as="line">
                                    <td><span t-esc="line['day']"/></td>
                                    <td><span t-esc="line['start_time']"/></td>
                                    <td><span t-esc="line['end_time']"/></td>
                                    <td><span t-esc="line['total']"/></td>

                                    <td><span t-esc="line['night_work']"/></td>
                                    <td><span t-esc="line['overtime']"/></td>
                                    <td><span t-esc="line['holiday']"/></td>

                                    <td><span t-esc="line['non_working_sunday']"/></td>
                                    <td><span t-esc="line['non_working_holiday']"/></td>
                                    <td><span t-esc="line['daily_rest']"/></td>

                                    <td><span t-esc="line['weekly_rest']"/></td>
                                    <td><span t-esc="line['annual_leave_hours']"/></td>
                                    <td><span t-esc="line['shift_work']"/></td>

                                    <td><span t-esc="line['split_shift_work']"/></td>
                                    <td><span t-esc="line['rescheduled_hours']"/></td>
                                    <td><span t-esc="line['fieldwork']"/></td>

                                    <td><span t-esc="line['fieldwork_abroad']"/></td>
                                    <td><span t-esc="line['seconded_work']"/></td>
                                    <td><span t-esc="line['sick_leave']"/></td>

                                    <td><span t-esc="line['sick_leave_fund']"/></td>
                                    <td><span t-esc="line['maternity_leave']"/></td>
                                    <td><span t-esc="line['paternity_leave']"/></td>
                                    <td><span t-esc="line['parental_leave']"/></td>
                                    <td><span t-esc="line['other_maternity_leave']"/></td>

                                    <td><span t-esc="line['paid_leave']"/></td>
                                    <td><span t-esc="line['unpaid_leave']"/></td>
                                    <td><span t-esc="line['work_absence']"/></td>
                                    <td><span t-esc="line['unpaid_personal_care']"/></td>
                                    <td><span t-esc="line['unpaid_candidacy']"/></td>
                                    <td><span t-esc="line['military_leave_absence']"/></td>
                                    <td><span t-esc="line['absence']"/></td>

                                    <td><span t-esc="line['absence_fault']"/></td>
                                    <td><span t-esc="line['strike']"/></td>
                                    <td><span t-esc="line['lockout']"/></td>

                                    <td><span t-esc="line['outage']"/></td>
                                    <td><span t-esc="line['time_outage']"/></td>
                                    <td><span t-esc="line['standby_hours']"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <!--Signature line-->
                <div style="padding-left: 80px; margin-top: 20px;">
                    <table class="table-borderless">
                        <tbody>
                            <tr>
                                <td style="width:70%;"></td>
                                <td style="border-bottom: 1px solid black;width:350px;"></td>
                            </tr>
                            <tr>
                                <td class="text-center"></td>
                                <td class="text-center" style="font-size: 7pt;">Odgovorna osoba</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            <p style="page-break-after: always;"/>
        </t>
        </t>
        </t>
    </template>

</odoo>
