<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="l10n_hr_working_hours_schedule_list_view" model="ir.ui.view">
        <field name="name">l10n_hr_working_hours_schedule_list_view</field>
        <field name="model">l10n_hr.working.hours.schedule</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="compute_date"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="business_premise_ids" widget="many2many_tags"/>
                <field name="fiscal_operation_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="l10n_hr_working_hours_schedule_line_list_view" model="ir.ui.view">
        <field name="name">l10n_hr_working_hours_schedule_line_list_view</field>
        <field name="model">l10n_hr.working.hours.schedule.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-muted="closed">
                <field name="business_premise_id"/>
                <field name="date"/>
                <field name="dow"/>
                <field name="shift_type"/>
                <field name="split_shift"/>
                <field name="time_from"/>
                <field name="time_to"/>
                <field name="closed"/>
            </list>
        </field>
    </record>

    <record id="l10n_hr_working_hours_schedule_form_view" model="ir.ui.view">
        <field name="name">l10n_hr_working_hours_schedule_form_view</field>
        <field name="model">l10n_hr.working.hours.schedule</field>
        <field name="arch" type="xml">
            <form string="Working Hours Schedule" duplicate="0">
                <sheet>
                    <group>
                        <group>
                            <field name="compute_date" readonly="1"/>
                            <field name="date_from" readonly="line_ids"/>
                            <field name="date_to" readonly="line_ids"/>
                        </group>
                        <group>
                            <field name="business_premise_ids" widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="All premises of the current company"
                                   readonly="line_ids"/>
                            <field name="fiscal_operation_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                    </group>
                    <button name="action_compute" type="object" string="Compute Schedule"
                            class="btn-primary" invisible="line_ids"/>
                    <field name="line_ids" nolabel="1" colspan="4" readonly="1">
                        <list create="0" edit="0" delete="0" decoration-muted="closed">
                            <field name="business_premise_id"/>
                            <field name="date"/>
                            <field name="dow"/>
                            <field name="shift_type"/>
                            <field name="split_shift"/>
                            <field name="time_from"/>
                            <field name="time_to"/>
                            <field name="closed"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="l10n_hr_working_hours_schedule_search_view" model="ir.ui.view">
        <field name="name">l10n_hr_working_hours_schedule_search_view</field>
        <field name="model">l10n_hr.working.hours.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="business_premise_ids"/>
                <field name="fiscal_operation_id"/>
                <filter name="manual" string="Manual Snapshots"
                        domain="[('fiscal_operation_id', '=', False)]"/>
                <filter name="from_operation" string="From Fiscal Operation"
                        domain="[('fiscal_operation_id', '!=', False)]"/>
                <group>
                    <filter name="group_premise" string="Business Premise"
                            context="{'group_by': 'business_premise_ids'}"/>
                    <filter name="group_date" string="Computed On"
                            context="{'group_by': 'compute_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_l10n_hr_working_hours_schedule" model="ir.actions.act_window">
        <field name="name">Working Hours Schedule History</field>
        <field name="res_model">l10n_hr.working.hours.schedule</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="menu_action_l10n_hr_working_hours_schedule"
            action="action_l10n_hr_working_hours_schedule"
            parent="l10n_hr_account_base.menu_finance_config_croatia"
            sequence="97"
    />

</odoo>
