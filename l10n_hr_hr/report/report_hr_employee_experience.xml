              <th class="text-center" style="width: 3in; border: 2px solid gray;">Mjeseci</th>
              <th class="text-center" style="width: 2in; border: 2px solid gray;">Dana</th>
            </tr>
          </thead>
          <tbody>
            <t t-set="counter" t-value="0" />
            <t t-foreach="docs" t-as="o">
              <t t-set="counter" t-value="counter + 1" />
              <tr style="page-break-inside:avoid;">
