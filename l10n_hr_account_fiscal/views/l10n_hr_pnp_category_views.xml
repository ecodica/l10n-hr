<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_hr_pnp_category_list_view" model="ir.ui.view">
        <field name="name">l10n_hr_pnp_category_list_view</field>
        <field name="model">l10n_hr.pnp.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="l10n_hr_pnp_category_form_view" model="ir.ui.view">
        <field name="name">l10n_hr_pnp_category_form_view</field>
        <field name="model">l10n_hr.pnp.category</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_l10n_hr_pnp_category" model="ir.actions.act_window">
        <field name="name">PNP Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">l10n_hr.pnp.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
            id="action_pnp_category_menu"
            action="action_l10n_hr_pnp_category"
            parent="l10n_hr_account_base.menu_finance_config_croatia"
            sequence="99"
    />

</odoo>
